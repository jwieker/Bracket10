# Copy this file to `.env` and fill in real values.
# `npm run dev` / `npm start` will load it automatically via Node's
# built-in `--env-file-if-exists` flag.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Long random string used to sign session cookies. Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port the HTTP server listens on. Defaults to 8080.
PORT=8080

# `development` enables verbose logs and uses the dev tournament year.
# `test` silences logs but still uses the dev tournament year.
# `production` uses the calendar year and serves the prod UI.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Google Cloud / Firestore
# ---------------------------------------------------------------------------

# Your GCP project ID. On Cloud Run this is set automatically.
# Locally, set it explicitly or run `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
# Some scripts read this alternate name; set both for safety.
GCP_PROJECT_ID=

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------

# The apex host the app is served from in production. Used for the
# `www.<host>` → `<host>` redirect in server.js and for building the
# Google OAuth callback URL in src/config/auth.js. Leave empty locally.
APP_HOST=

# Explicit OAuth callback override. Use this for tunnels, preview envs,
# or any setup where the callback isn't `https://<APP_HOST>/auth/google/callback`.
# Examples:
#   REDIRECT_URI=https://my-tunnel.ngrok.app/auth/google/callback
#   REDIRECT_URI=http://localhost:3000/auth/google/callback
# Leave unset to let the app derive the URL from APP_HOST + NODE_ENV.
REDIRECT_URI=

# ---------------------------------------------------------------------------
# Admin auth (Google OAuth)
# ---------------------------------------------------------------------------
# Create a Web Application OAuth client in Google Cloud Console with
# redirect URI:  https://<APP_HOST>/auth/google/callback
# (or http://localhost:8080/auth/google/callback for local dev).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of admin emails. Anyone outside this list
# who completes the OAuth flow will be rejected.
ADMIN_EMAILS=

# Kill switch for the Firestore-backed rate limiters (login, entry verify).
# Set to 1 to bypass the Firestore store; those limiters then allow all
# requests through. The in-memory public limiter is unaffected. Leave unset
# in production.
RATE_LIMIT_FIRESTORE_DISABLED=

# ---------------------------------------------------------------------------
# Admin Cloud dashboard (optional)
# Powers the /admin/cloud page (budgets, deploy button, quick links).
# Leave unset to disable.
# ---------------------------------------------------------------------------

GCP_BILLING_ACCOUNT_ID=
GCP_CLOUD_BUILD_TRIGGER_ID=
GCP_DEPLOY_BRANCH=main

# BigQuery table that receives the Cloud Billing export, e.g.
# `my-project.billing_export.gcp_billing_export_v1_XXXXXX`.
# The /admin/cloud page queries it for month-to-date spend. Leave unset
# to hide the spend widget.
GCP_BILLING_EXPORT_TABLE=

# ---------------------------------------------------------------------------
# Pool configuration
# ---------------------------------------------------------------------------

# Default group name used when one isn't specified. Shown in some
# admin views. Defaults to "Default".
DEFAULT_GROUP=

# Group whose unsent entries get drafted into emails by the admin
# email-batch helper. Leave empty to disable the helper.
EMAIL_GROUP=

# Comma-separated list of group names to filter out of standard listings
# (e.g. legacy or sandbox groups).
EXCLUDED_GROUPS=

# Comma-separated list of group names that should be pinned to the top
# of group pickers (your "house" groups).
PRIORITY_GROUPS=

# Optional: when an entry joins this exact group, the confirmation page
# renders a payment-collector contact block (Zelle/PayPal/Venmo, name,
# email, phone) using the values below. Leave empty to never render it.
PAYMENT_COLLECTOR_GROUP=
PAYMENT_COLLECTOR_NAME=
PAYMENT_COLLECTOR_EMAIL=
PAYMENT_COLLECTOR_PHONE=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID (looks like `G-XXXXXXXXXX`). When set,
# the gtag snippet is rendered in the shared user-facing header. Leave
# unset to omit GA entirely — the default for self-hosted forks.
GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# ESPN polling job (jobs/espn-poll.js)
# ---------------------------------------------------------------------------

# Tournament year the polling job pulls scoreboards for. Required —
# the job exits with an error if this isn't set. Typically the current
# calendar year during March; override for backfills.
POLL_YEAR=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# When `1` or `true`, error responses include stack traces and the
# original error message. Off by default — leaking internals to end
# users is a footgun. Enable only for local debugging.
DEBUG_ERRORS=

# ---------------------------------------------------------------------------
# Live e2e tests (optional)
# Set LIVE_E2E=true to run tests/*.live.test.js against a real Firestore.
# ---------------------------------------------------------------------------
# LIVE_E2E=false
