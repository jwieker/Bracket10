<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
</head>

<body>
    <div class="container-lg pt-3">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                    <div>
                        <h1 class="t-h1 mb-1">My Brackets</h1>
                        <div class="text-muted">Signed in as <%= userEmail %></div>
                    </div>
                    <form action="/user/logout" method="post" class="mb-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                    </form>
                </div>

                <% if (editWindowOpen) { %>
                    <div class="alert alert-success py-2">Editing is open — you can update your current bracket below.</div>
                <% } else { %>
                    <div class="alert alert-secondary py-2">Editing is closed. Your brackets are shown read-only.</div>
                <% } %>

                <% if (!entries || entries.length === 0) { %>
                    <div class="alert alert-info">
                        <p class="mb-1">No brackets found for <strong><%= userEmail %></strong>.</p>
                        <p class="mb-0">
                            Brackets are matched by the email you registered with. If you registered with a
                            different email, use the <a href="/my-entry">Entry&nbsp;ID lookup</a> instead.
                        </p>
                    </div>
                <% } else { %>
                    <%
                        // Group the (already year-desc sorted) entries by year for display.
                        const byYear = {};
                        entries.forEach((e) => { (byYear[e.year] = byYear[e.year] || []).push(e); });
                        const years = Object.keys(byYear).sort((a, b) => b - a);
                    %>
                    <% years.forEach((yr) => { %>
                        <h2 class="t-h2 mt-4 mb-2"><%= yr %></h2>
                        <div class="list-group mb-2">
                            <% byYear[yr].forEach((entry) => { %>
                                <div class="list-group-item">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-bold"><%= entry.teamName %></div>
                                            <div class="text-muted small"><%= entry.person %></div>
                                            <div class="mt-1">
                                                <% (entry.groups || []).forEach((g) => { %>
                                                    <% if (entry.editable) { %>
                                                        <span class="badge bg-secondary me-1"><%= g %></span>
                                                    <% } else { %>
                                                        <form action="/gameView" method="post" class="d-inline">
                                                            <input type="hidden" name="game" value="<%= g %>">
                                                            <input type="hidden" name="year" value="<%= entry.year %>">
                                                            <button type="submit" class="badge bg-secondary border-0 me-1"
                                                                style="cursor: pointer;" title="View the <%= g %> group">
                                                                <%= g %>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                <% }); %>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="small text-muted">
                                                Points: <strong><%= entry.totalPoints %></strong>
                                                &middot; Max possible: <%= entry.possPoints %>
                                            </div>
                                            <div class="mt-2">
                                                <% if (entry.editable) { %>
                                                    <a class="btn btn-primary btn-sm"
                                                        href="/my-brackets/edit?entryId=<%= encodeURIComponent(entry.id) %>&year=<%= encodeURIComponent(entry.year) %>">
                                                        Edit
                                                    </a>
                                                <% } else if (entry.viewGroup) { %>
                                                    <form action="/gameView" method="post" class="d-inline-block mb-0">
                                                        <input type="hidden" name="game" value="<%= entry.viewGroup %>">
                                                        <input type="hidden" name="year" value="<%= entry.year %>">
                                                        <button type="submit" class="btn btn-outline-primary btn-sm">View bracket</button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% }); %>
                <% } %>

            </div>
        </div>
    </div>

    <div>
        <%- include('partials/rulesModal') %>
        <%- include('partials/scripts') %>
    </div>
</body>

</html>
