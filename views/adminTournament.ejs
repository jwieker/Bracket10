<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/admin-header') %>
        <title>Game Results — Admin</title>
</head>

<% const adminSection='tournament' ; %>

    <body>
        <%- include('partials/admin-nav', { year, adminSection }) %>

            <div class="container-xl pt-1" id="regcont">
                <div class="row" id="row1">
                    <div class="col-12 pl-1 pr-1 mb-2 align-self-center" id="col2">

                        <div>
                            <% const hasRound1Winner=activeGames.some(game=> game.round === 1 && game.winner); %>
                        </div>

                        <!-- Tournament management actions -->
                        <div class="d-flex flex-wrap gap-2 mb-2 align-items-center justify-content-between">
                            <div class="d-flex gap-2">
                                <% if (typeof isNewTournament !=='undefined' && isNewTournament) { %>
                                    <form action="/setupNewTourney" method="post" class="d-inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <button class="btn btn-primary" type="submit">Create <%= year %> Bracket</button>
                                    </form>
                                <% } %>
                            </div>
                            <div>
                                <button id="pwaRefreshBtn" class="btn btn-outline-secondary d-none"
                                    data-act="reloadPage" title="Refresh page">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                        fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd"
                                            d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                        <path
                                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                    </svg>
                                    Refresh
                                </button>
                                <script nonce="<%= cspNonce %>">
                                    if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
                                        document.getElementById('pwaRefreshBtn').classList.remove('d-none');
                                    }
                                </script>
                            </div>
                        </div>
                        <!-- hidden year input used by JS for game submissions -->
                        <input type="hidden" id="currentYearInput" value="<%= year %>">
                        <div class="d-flex gap-2 mb-3 justify-content-center">
                            <form action="/editTournament" method="post" id="editTournamentForm" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="year" value="<%= year %>">
                                <button class="btn btn-outline-secondary" type="submit" <%= hasRound1Winner ? 'disabled' : '' %>>Edit <%= year %> Tournament</button>
                            </form>
                            <button class="btn btn-outline-warning" type="button" id="espnPollBtn">Poll ESPN</button>
                            <% if (isDev) { %>
                            <input type="date" id="espnPollDate" class="form-control form-control-sm d-inline-block ms-1" style="width:auto;" placeholder="today">
                            <% } %>
                        </div>

                        <div id="espnPollResults" class="container pt-1 pb-1" style="display:none;">
                            <div class="row">
                                <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                    <div id="espnPollResultsInner" class="border rounded p-2"
                                        style="font-size: 0.9rem;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- desktop table view  -->
                        <div class="mt-2 mb-3 d-none d-lg-block w-100">
                            <div class="table-responsive table-scroll w-100" data-mdb-perfect-scrollbar="true"
                                style="position: relative; max-height: 75vh">
                                <table class="table table-striped mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th colspan="3" class="text-center border-secondary border-2">
                                                Game</th>
                                            <th colspan="3" class="text-center border-secondary border-2">
                                                Team 1</th>
                                            <th colspan="3" class="text-center border-secondary border-2">
                                                Team 2</th>
                                            <th colspan="2" class="text-center border-secondary border-2">
                                                Next Game</th>
                                            <th colspan="4" class="text-center border-secondary border-2">
                                                Update Info</th>
                                        </tr>
                                        <tr>
                                            <th class="border-secondary border-2">GameID</th>
                                            <th class="border-secondary border-2">Round</th>
                                            <th class="border-secondary border-2">Region</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">Spot</th>
                                            <th class="border-secondary border-2">Winner</th>
                                            <th class="border-secondary border-2">Button</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% activeGames.forEach(group=> { %>
                                            <tr class="game-row" data-game-id="<%= group.gameID %>"
                                                data-round="<%= group.round %>"
                                                data-region="<%= group.regionName %>"
                                                data-team1-id="<%= group.team1ID %>"
                                                data-team1-name="<%= group.team1Name %>"
                                                data-team2-id="<%= group.team2ID %>"
                                                data-team2-name="<%= group.team2Name %>"
                                                data-next-game-id="<%= group.nextGameID %>"
                                                data-next-game-spot="<%= group.nextGameSpot %>">
                                                <td>
                                                    <%= group.gameID %>
                                                </td>
                                                <td class="round-display" data-round="<%= group.round %>">
                                                    <%= group.round === 0 ? 'FF' : group.round %>
                                                </td>
                                                <td>
                                                    <%= group.regionName %>
                                                </td>
                                                <td>
                                                    <%= group.team1Seed %>
                                                </td>
                                                <td>
                                                    <%= group.team1Name %>
                                                </td>
                                                <td>
                                                    <%= group.team1ID %>
                                                </td>
                                                <td>
                                                    <%= group.team2Seed %>
                                                </td>
                                                <td>
                                                    <%= group.team2Name %>
                                                </td>
                                                <td>
                                                    <%= group.team2ID %>
                                                </td>
                                                <td class="next-game-display">
                                                    <%= group.nextGameID %>
                                                </td>
                                                <td>
                                                    <%= group.nextGameSpot %>
                                                </td>
                                                <td>
                                                    <span class="winner-name-display">
                                                        <%= group.winnerName %>
                                                    </span>
                                                    <select class="form-select winner-select">
                                                        <option value="<%= group.team1ID %>">
                                                            <%= group.team1Name %>
                                                        </option>
                                                        <option value="<%= group.team2ID %>">
                                                            <%= group.team2Name %>
                                                        </option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <button
                                                        class="btn btn-primary submit-game-result">Submit</button>
                                                    <button
                                                        class="btn btn-primary undo-game-result">Undo</button>
                                                    <% if (group.manualHold && !group.winner) { %>
                                                        <button class="btn btn-warning release-hold-btn"
                                                            data-game-id="<%= group.gameID %>"
                                                            title="Undone game — the ESPN poll is skipping it. Release to let the poll resolve it again.">
                                                            Release Hold</button>
                                                    <% } %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- mobile card view -->
                        <div class="d-lg-none mt-3 px-2 pb-4">
                            <% activeGames.forEach(group=> { %>
                                <div class="card mb-3 game-row shadow-sm" data-game-id="<%= group.gameID %>"
                                    data-round="<%= group.round %>" data-region="<%= group.regionName %>"
                                    data-team1-id="<%= group.team1ID %>" data-team1-name="<%= group.team1Name %>"
                                    data-team2-id="<%= group.team2ID %>" data-team2-name="<%= group.team2Name %>"
                                    data-next-game-id="<%= group.nextGameID %>"
                                    data-next-game-spot="<%= group.nextGameSpot %>">
                                    <div
                                        class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold round-display" data-round="<%= group.round %>"><%= group.round === 0 ? 'First Four' : `Round ${group.round}` %></span>
                                        <span class="badge bg-secondary">
                                            <%= group.regionName %>
                                        </span>
                                        <span class="d-none next-game-display">
                                            <%= group.nextGameID %>
                                        </span>
                                    </div>
                                    <div class="card-body py-3">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="text-center" style="width: 45%;">
                                                <span class="badge bg-light text-dark mb-1 border">
                                                    <%= group.team1Seed %>
                                                </span>
                                                <h6 class="mb-0 text-truncate">
                                                    <%= group.team1Name %>
                                                </h6>
                                            </div>
                                            <div class="text-muted small fw-bold">VS</div>
                                            <div class="text-center" style="width: 45%;">
                                                <span class="badge bg-light text-dark mb-1 border">
                                                    <%= group.team2Seed %>
                                                </span>
                                                <h6 class="mb-0 text-truncate">
                                                    <%= group.team2Name %>
                                                </h6>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <div
                                                class="mb-2 text-center text-success fw-bold winner-name-display-container">
                                                <span class="winner-name-display">
                                                    <%= group.winnerName %>
                                                </span>
                                            </div>
                                            <select class="form-select mb-2 winner-select">
                                                <option value="<%= group.team1ID %>">
                                                    <%= group.team1Name %>
                                                </option>
                                                <option value="<%= group.team2ID %>">
                                                    <%= group.team2Name %>
                                                </option>
                                            </select>
                                            <div class="d-flex gap-2 justify-content-center mt-2">
                                                <button class="btn btn-primary w-100 submit-game-result">Submit
                                                    Winner</button>
                                                <button class="btn btn-warning w-100 undo-game-result">Undo
                                                    Winner</button>
                                            </div>
                                            <% if (group.manualHold && !group.winner) { %>
                                                <button class="btn btn-warning w-100 mt-2 release-hold-btn"
                                                    data-game-id="<%= group.gameID %>">
                                                    Release Poll Hold</button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <%- include('partials/rulesModal') %>
                    <%- include('partials/scripts') %>
            </div>

            <script nonce="<%= cspNonce %>">
                document.addEventListener('DOMContentLoaded', () => {
                    const currentYear = document.getElementById('currentYearInput').value;

                    const espnPollDateInput = document.getElementById('espnPollDate');
                    if (espnPollDateInput) {
                        espnPollDateInput.addEventListener('keydown', (e) => {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                document.getElementById('espnPollBtn').click();
                            }
                        });
                    }

                    const espnPollBtn = document.getElementById('espnPollBtn');
                    if (espnPollBtn) {
                        espnPollBtn.addEventListener('click', async () => {
                            const resultsWrapper = document.getElementById('espnPollResults');
                            const resultsInner = document.getElementById('espnPollResultsInner');
                            const makeSpan = (cls, text) => {
                                const s = document.createElement('span');
                                s.className = cls;
                                s.textContent = text;
                                return s;
                            };
                            espnPollBtn.disabled = true;
                            espnPollBtn.textContent = 'Polling...';
                            resultsWrapper.style.display = 'none';

                            try {
                                const dateInput = document.getElementById('espnPollDate');
                                const dateVal = dateInput && dateInput.value ? dateInput.value.replace(/-/g, '') : null;
                                const body = dateVal ? JSON.stringify({ dateStr: dateVal }) : null;
                                const response = await fetch('/admin/trigger-espn-poll', {
                                    method: 'POST',
                                    headers: { 'x-csrf-token': '<%= csrfToken %>', 'Accept': 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}) },
                                    ...(body ? { body } : {}),
                                });
                                const data = await response.json();

                                const nodes = [];
                                if (!response.ok) {
                                    nodes.push(makeSpan('text-danger', `Error: ${data.error || 'Unknown error'}`));
                                } else if (data.games.length === 0) {
                                    nodes.push(makeSpan('text-muted', 'No new completed games found.'));
                                } else {
                                    const roundLabel = (r) => ({0: 'FF', 1: 'R1', 2: 'R2', 3: 'Sweet 16', 4: 'Elite 8', 5: 'Final Four', 6: 'Championship'}[r] ?? `R${r}`);
                                    const heading = document.createElement('strong');
                                    heading.textContent = 'ESPN says these games are done:';
                                    const ul = document.createElement('ul');
                                    ul.className = 'mb-1 mt-1 list-unstyled';
                                    data.games.forEach(g => {
                                        const li = document.createElement('li');
                                        li.className = 'd-flex align-items-center gap-2 mb-1';

                                        const span = document.createElement('span');
                                        const winner = document.createElement('strong');
                                        winner.textContent = g.winnerDisplayName ?? '';
                                        span.append(`${roundLabel(g.round)} · Game ${g.gameID}: `, winner, ' wins');

                                        const btn = document.createElement('button');
                                        btn.className = 'btn btn-sm btn-success espn-submit-btn';
                                        btn.textContent = 'Submit';
                                        btn.dataset.gameId = g.gameID;
                                        btn.dataset.round = g.round;
                                        btn.dataset.winnerId = g.winnerSID;
                                        btn.dataset.winnerName = g.winnerDisplayName ?? '';
                                        btn.dataset.team1Id = g.team1ID;
                                        btn.dataset.team2Id = g.team2ID;
                                        btn.dataset.nextGameId = g.nextGameID ?? '';
                                        btn.dataset.nextGameSpot = g.nextGameSpot ?? '';

                                        li.append(span, btn);
                                        ul.appendChild(li);
                                    });
                                    nodes.push(heading, ul);
                                }
                                if (data.unmapped && data.unmapped.length > 0) {
                                    nodes.push(makeSpan('text-warning', `Unmapped teams (update espnTeamMap.json): ${data.unmapped.join(', ')}`));
                                }

                                resultsInner.replaceChildren(...nodes);
                                resultsWrapper.style.display = 'block';
                            } catch (error) {
                                resultsInner.replaceChildren(makeSpan('text-danger', 'Failed to reach server.'));
                                resultsWrapper.style.display = 'block';
                            } finally {
                                espnPollBtn.disabled = false;
                                espnPollBtn.textContent = 'Poll ESPN';
                            }
                        });
                    }

                    document.getElementById('espnPollResultsInner').addEventListener('click', async (e) => {
                        const btn = e.target.closest('.espn-submit-btn');
                        if (!btn) return;

                        btn.disabled = true;
                        btn.textContent = 'Submitting...';

                        const gameData = {
                            gameID: btn.dataset.gameId,
                            round: btn.dataset.round,
                            winnerID: btn.dataset.winnerId,
                            winnerName: btn.dataset.winnerName,
                            team1ID: btn.dataset.team1Id,
                            team2ID: btn.dataset.team2Id,
                            nextGameID: btn.dataset.nextGameId,
                            nextGameSpot: btn.dataset.nextGameSpot,
                            year: currentYear
                        };

                        try {
                            const response = await fetch('/updateWinner', {
                                method: 'POST',
                                headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify(gameData)
                            });
                            if (response.ok) {
                                btn.textContent = 'Done';
                                btn.classList.replace('btn-success', 'btn-secondary');
                            } else {
                                btn.textContent = 'Error';
                                btn.classList.replace('btn-success', 'btn-danger');
                                btn.disabled = false;
                            }
                        } catch (error) {
                            btn.textContent = 'Error';
                            btn.classList.replace('btn-success', 'btn-danger');
                            btn.disabled = false;
                        }
                    });

                    const gameRows = document.querySelectorAll('.game-row');

                    let maxRound = 0;
                    gameRows.forEach(row => {
                        const round = parseInt(row.dataset.round);
                        if (round > maxRound) maxRound = round;
                    });

                    const applyStripedStyling = () => {
                        const visibleRows = Array.from(document.querySelectorAll('.table tbody tr'))
                            .filter(row => row.style.display !== 'none');
                        visibleRows.forEach((row, index) => {
                            if (index % 2 === 0) {
                                row.classList.add('table-striped');
                                row.classList.remove('table-secondary');
                            } else {
                                row.classList.remove('table-striped');
                                row.classList.add('table-secondary');
                            }
                        });
                    };
                    applyStripedStyling();

                    gameRows.forEach((row) => {
                        const round = parseInt(row.dataset.round);
                        const nextGameID = row.dataset.nextGameId || '';
                        const winnerNameSpan = row.querySelector('.winner-name-display');
                        const winnerCellName = winnerNameSpan ? winnerNameSpan.textContent.trim() : '';

                        let hideRow = false;

                        if (round !== maxRound && round !== maxRound - 1) {
                            hideRow = true;
                        }

                        if (nextGameID !== "") {
                            const nextGameRows = Array.from(gameRows).filter(r => r.dataset.gameId === nextGameID);
                            if (nextGameRows && nextGameRows.length > 0) {
                                const nextGameRow = nextGameRows[0];
                                const nextGameWinnerSpan = nextGameRow.querySelector('.winner-name-display');
                                const nextGameWinnerName = nextGameWinnerSpan ? nextGameWinnerSpan.textContent.trim() : '';
                                if (nextGameWinnerName !== "") {
                                    hideRow = true;
                                }
                            }
                        }

                        if (hideRow) {
                            if (row.classList.contains('d-flex') || row.classList.contains('card')) {
                                row.classList.remove('d-flex');
                                row.style.setProperty('display', 'none', 'important');
                            } else {
                                row.style.display = 'none';
                            }
                        }
                    });
                    applyStripedStyling();

                    gameRows.forEach((row) => {
                        const submitButton = row.querySelector('.submit-game-result');
                        const undoButton = row.querySelector('.undo-game-result');
                        const formSelect = row.querySelector('.winner-select');

                        const gameID = row.dataset.gameId;
                        const winnerNameSpan = row.querySelector('.winner-name-display');
                        const winnerCellName = winnerNameSpan ? winnerNameSpan.textContent.trim() : '';

                        if (winnerCellName !== '') {
                            if (undoButton) undoButton.style.display = 'block';
                            if (submitButton) submitButton.style.display = 'none';
                            if (formSelect) formSelect.style.display = 'none';
                        } else {
                            if (undoButton) undoButton.style.display = 'none';
                            if (submitButton) submitButton.style.display = 'block';
                            if (formSelect) formSelect.style.display = 'block';
                        }

                        if (submitButton) {
                            submitButton.addEventListener('click', async () => {
                                const winnerSelect = row.querySelector('.winner-select');
                                const winnerNameConfirm = winnerSelect.options[winnerSelect.selectedIndex].text;
                                if (!window.confirm(`Set winner for game ${gameID}: ${winnerNameConfirm}?`)) return;

                                const allButtons = document.querySelectorAll('.game-row button');
                                allButtons.forEach(button => { button.disabled = true; });
                                submitButton.textContent = 'Loading...';

                                const roundID = row.dataset.round;
                                const regionID = row.dataset.region;
                                const team1Name = row.dataset.team1Name;
                                const team1ID = row.dataset.team1Id;
                                const team2Name = row.dataset.team2Name;
                                const team2ID = row.dataset.team2Id;
                                const nextGameID = row.dataset.nextGameId;
                                const nextGameSpot = row.dataset.nextGameSpot;
                                const winnerID = winnerSelect.value;
                                const winnerName = winnerSelect.options[winnerSelect.selectedIndex].text;

                                const gameData = {
                                    gameID, regionID, round: roundID,
                                    team1ID, team1Name, team2ID, team2Name,
                                    nextGameID, nextGameSpot, winnerID, winnerName, year: currentYear
                                };

                                try {
                                    const response = await fetch('/updateWinner', {
                                        method: 'POST',
                                        headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: JSON.stringify(gameData)
                                    });
                                    if (response.ok) {
                                        alert('Game result submitted successfully! The page will refresh on OK.');
                                        window.location.reload();
                                    } else {
                                        alert('Error submitting game result. Please try again.');
                                        document.querySelectorAll('.game-row button').forEach(b => b.disabled = false);
                                        submitButton.textContent = 'Submit';
                                    }
                                } catch (error) {
                                    console.error('Error submitting game result:', error);
                                    alert('Network error submitting game result. Please try again.');
                                    document.querySelectorAll('.game-row button').forEach(b => b.disabled = false);
                                    submitButton.textContent = 'Submit';
                                }
                            });
                        }

                        if (undoButton) {
                            undoButton.addEventListener('click', async () => {
                                if (!window.confirm(`Undo the winner for game ${gameID}?`)) return;

                                const allButtons = document.querySelectorAll('.game-row button');
                                allButtons.forEach(button => { button.disabled = true; });
                                undoButton.textContent = 'Loading...';

                                const roundID = row.dataset.round;
                                const regionID = row.dataset.region;
                                const team1Name = row.dataset.team1Name;
                                const team1ID = row.dataset.team1Id;
                                const team2Name = row.dataset.team2Name;
                                const team2ID = row.dataset.team2Id;
                                const nextGameID = row.dataset.nextGameId;
                                const nextGameSpot = row.dataset.nextGameSpot;
                                const winnerSelect = row.querySelector('.winner-select');
                                const winnerID = winnerSelect.value;
                                const winnerName = winnerSelect.options[winnerSelect.selectedIndex].text;

                                const gameData = {
                                    gameID, regionID, round: roundID,
                                    team1ID, team1Name, team2ID, team2Name,
                                    nextGameID, nextGameSpot, winnerID, winnerName, year: currentYear
                                };

                                try {
                                    const response = await fetch('/undoGame', {
                                        method: 'POST',
                                        headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: JSON.stringify(gameData)
                                    });
                                    if (response.ok) {
                                        alert('Game result undone successfully! The page will refresh on OK.');
                                        window.location.reload();
                                    } else {
                                        alert('Error undoing game result. Please try again.');
                                        document.querySelectorAll('.game-row button').forEach(b => b.disabled = false);
                                        undoButton.textContent = 'Undo';
                                    }
                                } catch (error) {
                                    console.error('Error undoing game result:', error);
                                    alert('Network error undoing game result. Please try again.');
                                    document.querySelectorAll('.game-row button').forEach(b => b.disabled = false);
                                    undoButton.textContent = 'Undo';
                                }
                            });
                        }

                        const releaseHoldButton = row.querySelector('.release-hold-btn');
                        if (releaseHoldButton) {
                            releaseHoldButton.addEventListener('click', async () => {
                                if (!window.confirm(`Release the poll hold on game ${gameID}? The ESPN poll may immediately re-apply the result from its feed.`)) return;
                                releaseHoldButton.disabled = true;
                                try {
                                    const response = await fetch('/releaseGameHold', {
                                        method: 'POST',
                                        headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: JSON.stringify({ gameID, year: currentYear })
                                    });
                                    if (response.ok) {
                                        alert('Hold released. The page will refresh on OK.');
                                        window.location.reload();
                                    } else {
                                        alert('Error releasing hold. Please try again.');
                                        releaseHoldButton.disabled = false;
                                    }
                                } catch (error) {
                                    console.error('Error releasing hold:', error);
                                    alert('Network error releasing hold. Please try again.');
                                    releaseHoldButton.disabled = false;
                                }
                            });
                        }
                    });
                });

                function refreshPage() {
                    window.location.reload();
                }
            </script>

    </body>

</html>