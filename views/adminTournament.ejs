<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/admin-header') %>
        <title>Game Results — Admin</title>
        <style>
            #gamesTable.games-compact .col-detail {
                display: none;
            }
            /* One container step down from container-xl (1140px → 960px); narrows the #col2 card and the table inside it. */
            #regcont.games-compact {
                max-width: 960px;
            }
            .admin-team-logo {
                width: 24px;
                height: 24px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-sm);
                background: var(--bg-card);
            }
            #gamesTable .team-pick-label .admin-team-logo {
                width: 28px;
                height: 28px;
            }
            .admin-team-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
            .admin-team-logo-fallback {
                font-size: 0.55rem;
                font-weight: 700;
                line-height: 1;
                color: var(--text-muted);
            }
            .team-pick-btn {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.4rem;
                width: 100%;
                padding: 0.4rem 0.6rem;
                background: transparent;
                color: var(--text-main);
                border: 2px solid var(--border-strong);
                border-radius: var(--radius-md);
                line-height: 1.2;
                text-align: center;
                cursor: pointer;
                transition: border-color 0.15s, background-color 0.15s, opacity 0.15s;
            }
            .team-pick-btn:hover {
                border-color: var(--primary-color);
                background: var(--bg-hover);
            }
            .team-pick-btn:focus-visible {
                outline: 2px solid var(--primary-color);
                outline-offset: 2px;
            }
            .team-pick-card {
                flex: 1 1 0;
                min-width: 0;
                flex-direction: column;
            }
            .team-pick-label {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                min-width: 0;
            }
            .team-pick-btn.is-winner {
                border-color: var(--success-color);
            }
            .team-pick-btn.is-loser {
                opacity: 0.5;
                filter: grayscale(0.6);
            }
            /* A decided game is settled until Undo, so its teams stop being buttons. */
            .game-row:not([data-winner-id=""]) .team-pick-btn {
                cursor: default;
                pointer-events: none;
            }
            .result-toast {
                position: fixed;
                bottom: 1rem;
                left: 50%;
                transform: translateX(-50%);
                z-index: 1090;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                max-width: calc(100vw - 2rem);
                padding: 0.6rem 0.9rem;
                background: var(--bg-card);
                color: var(--text-main);
                border: 1px solid var(--border-strong);
                border-left: 4px solid var(--success-color);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-lg);
            }
            .result-toast[hidden] {
                display: none;
            }
            .result-toast.is-error {
                border-left-color: var(--danger-color);
            }
        </style>
</head>

<% const adminSection='tournament' ; %>

    <body>
        <%- include('partials/admin-nav', { year, adminSection }) %>

            <div class="container-xl pt-1" id="regcont">
                <div class="row" id="row1">
                    <div class="col-12 pl-1 pr-1 mb-2 align-self-center" id="col2">

                        <div>
                            <% const hasRound1Winner=activeGames.some(game=> game.round === 1 && game.winner); %>
                        </div>

                        <!-- Tournament management actions -->
                        <div class="d-flex flex-wrap gap-2 mb-2 align-items-center justify-content-between">
                            <div class="d-flex gap-2">
                                <% if (typeof isNewTournament !=='undefined' && isNewTournament) { %>
                                    <form action="/setupNewTourney" method="post" class="d-inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <button class="btn btn-primary" type="submit">Create <%= year %> Bracket</button>
                                    </form>
                                    <a class="btn btn-outline-primary" href="/admin/tournament/espn-setup?year=<%= year %>">Create from ESPN</a>
                                <% } %>
                            </div>
                            <div>
                                <button id="pwaRefreshBtn" class="btn btn-outline-secondary d-none"
                                    data-act="reloadPage" title="Refresh page">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                        fill="currentColor" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd"
                                            d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                        <path
                                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                    </svg>
                                    Refresh
                                </button>
                                <script nonce="<%= cspNonce %>">
                                    if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
                                        document.getElementById('pwaRefreshBtn').classList.remove('d-none');
                                    }
                                </script>
                            </div>
                        </div>
                        <!-- hidden year input used by JS for game submissions -->
                        <input type="hidden" id="currentYearInput" value="<%= year %>">
                        <div class="d-flex gap-2 mb-3 justify-content-center">
                            <form action="/editTournament" method="post" id="editTournamentForm" class="d-inline">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="year" value="<%= year %>">
                                <button class="btn btn-outline-secondary" type="submit" <%= hasRound1Winner ? 'disabled' : '' %>>Edit <%= year %> Tournament</button>
                            </form>
                            <button class="btn btn-outline-warning" type="button" id="espnPollBtn">Poll ESPN</button>
                            <% if (isDev) { %>
                            <input type="date" id="espnPollDate" class="form-control form-control-sm d-inline-block ms-1" style="width:auto;" placeholder="today">
                            <% } %>
                            <button type="button" class="btn btn-outline-secondary d-none d-lg-inline-block"
                                id="toggleDetailsBtn" aria-controls="gamesTable" aria-expanded="true">Show less</button>
                        </div>

                        <div id="espnPollResults" class="container pt-1 pb-1" style="display:none;">
                            <div class="row">
                                <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                    <div id="espnPollResultsInner" class="border rounded p-2"
                                        style="font-size: 0.9rem;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- desktop table view  -->
                        <div class="mt-2 mb-3 d-none d-lg-block w-100">
                            <div class="table-responsive table-scroll w-100" data-mdb-perfect-scrollbar="true"
                                style="position: relative; max-height: 75vh">
                                <table class="table table-striped mb-0 w-100" id="gamesTable">
                                    <thead>
                                        <tr>
                                            <th colspan="3" data-span-full="3" data-span-short="2"
                                                class="text-center border-secondary border-2">
                                                Game</th>
                                            <th colspan="3" data-span-full="3" data-span-short="2"
                                                class="text-center border-secondary border-2">
                                                Team 1</th>
                                            <th colspan="3" data-span-full="3" data-span-short="2"
                                                class="text-center border-secondary border-2">
                                                Team 2</th>
                                            <th colspan="2" class="col-detail text-center border-secondary border-2">
                                                Next Game</th>
                                            <th class="text-center border-secondary border-2">
                                                Update Info</th>
                                        </tr>
                                        <tr>
                                            <th class="col-detail border-secondary border-2">GameID</th>
                                            <th class="border-secondary border-2">Round</th>
                                            <th class="border-secondary border-2">Region</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="col-detail border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="col-detail border-secondary border-2">ID</th>
                                            <th class="col-detail border-secondary border-2">ID</th>
                                            <th class="col-detail border-secondary border-2">Spot</th>
                                            <th class="border-secondary border-2">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% activeGames.forEach(group=> { %>
                                            <tr class="game-row" data-game-id="<%= group.gameID %>"
                                                data-round="<%= group.round %>"
                                                data-region="<%= group.regionName %>"
                                                data-team1-id="<%= group.team1ID %>"
                                                data-team1-name="<%= group.team1Name %>"
                                                data-team2-id="<%= group.team2ID %>"
                                                data-team2-name="<%= group.team2Name %>"
                                                data-next-game-id="<%= group.nextGameID %>"
                                                data-next-game-spot="<%= group.nextGameSpot %>"
                                                data-winner-id="<%= group.winner || '' %>">
                                                <td class="col-detail">
                                                    <%= group.gameID %>
                                                </td>
                                                <td class="round-display" data-round="<%= group.round %>">
                                                    <%= group.round === 0 ? 'FF' : group.round %>
                                                </td>
                                                <td>
                                                    <%= group.regionName %>
                                                </td>
                                                <td>
                                                    <%= group.team1Seed %>
                                                </td>
                                                <td>
                                                    <%- include('partials/adminTeamPick', { group, n: 1, layout: 'cell' }) %>
                                                </td>
                                                <td class="col-detail">
                                                    <%= group.team1ID %>
                                                </td>
                                                <td>
                                                    <%= group.team2Seed %>
                                                </td>
                                                <td>
                                                    <%- include('partials/adminTeamPick', { group, n: 2, layout: 'cell' }) %>
                                                </td>
                                                <td class="col-detail">
                                                    <%= group.team2ID %>
                                                </td>
                                                <td class="col-detail next-game-display">
                                                    <%= group.nextGameID %>
                                                </td>
                                                <td class="col-detail">
                                                    <%= group.nextGameSpot %>
                                                </td>
                                                <td>
                                                    <button
                                                        class="btn btn-primary undo-game-result<%= group.winner ? '' : ' d-none' %>">Undo</button>
                                                    <%# Always rendered, hidden when unheld: Undo sets manualHold server-side and
                                                        setGameState toggles d-none, so rendering it conditionally left an
                                                        in-session undo holding with no button until the reload. %>
                                                    <button
                                                        class="btn btn-warning release-hold-btn<%= group.manualHold && !group.winner ? '' : ' d-none' %>"
                                                        data-game-id="<%= group.gameID %>"
                                                        title="Undone game — the ESPN poll is skipping it. Release to let the poll resolve it again.">
                                                        Release Hold</button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- mobile card view -->
                        <div class="d-lg-none mt-3 px-2 pb-4">
                            <% activeGames.forEach(group=> { %>
                                <div class="card mb-3 game-row shadow-sm" data-game-id="<%= group.gameID %>"
                                    data-round="<%= group.round %>" data-region="<%= group.regionName %>"
                                    data-team1-id="<%= group.team1ID %>" data-team1-name="<%= group.team1Name %>"
                                    data-team2-id="<%= group.team2ID %>" data-team2-name="<%= group.team2Name %>"
                                    data-next-game-id="<%= group.nextGameID %>"
                                    data-next-game-spot="<%= group.nextGameSpot %>"
                                    data-winner-id="<%= group.winner || '' %>">
                                    <div
                                        class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold round-display" data-round="<%= group.round %>"><%= group.round === 0 ? 'First Four' : `Round ${group.round}` %></span>
                                        <span class="badge bg-secondary">
                                            <%= group.regionName %>
                                        </span>
                                        <span class="d-none next-game-display">
                                            <%= group.nextGameID %>
                                        </span>
                                    </div>
                                    <div class="card-body py-3">
                                        <div class="d-flex justify-content-between align-items-stretch gap-2 mb-3">
                                            <%- include('partials/adminTeamPick', { group, n: 1, layout: 'card' }) %>
                                            <div class="text-muted small fw-bold align-self-center">VS</div>
                                            <%- include('partials/adminTeamPick', { group, n: 2, layout: 'card' }) %>
                                        </div>
                                        <div class="mt-3">
                                            <button
                                                class="btn btn-warning w-100 undo-game-result<%= group.winner ? '' : ' d-none' %>">Undo
                                                Winner</button>
                                            <button
                                                class="btn btn-warning w-100 mt-2 release-hold-btn<%= group.manualHold && !group.winner ? '' : ' d-none' %>"
                                                data-game-id="<%= group.gameID %>">
                                                Release Poll Hold</button>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
                    </div>
                </div>
            </div>

            <div id="resultToast" class="result-toast" role="status" aria-live="polite" hidden>
                <span id="resultToastMsg"></span>
                <button type="button" id="resultToastAction" class="btn btn-sm btn-primary" hidden></button>
            </div>

            <div>
                <%- include('partials/rulesModal') %>
                    <%- include('partials/scripts') %>
            </div>

            <script nonce="<%= cspNonce %>">
                document.addEventListener('DOMContentLoaded', () => {
                    const currentYear = document.getElementById('currentYearInput').value;

                    const espnPollDateInput = document.getElementById('espnPollDate');
                    if (espnPollDateInput) {
                        espnPollDateInput.addEventListener('keydown', (e) => {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                document.getElementById('espnPollBtn').click();
                            }
                        });
                    }

                    const espnPollBtn = document.getElementById('espnPollBtn');
                    if (espnPollBtn) {
                        espnPollBtn.addEventListener('click', async () => {
                            const resultsWrapper = document.getElementById('espnPollResults');
                            const resultsInner = document.getElementById('espnPollResultsInner');
                            const makeSpan = (cls, text) => {
                                const s = document.createElement('span');
                                s.className = cls;
                                s.textContent = text;
                                return s;
                            };
                            espnPollBtn.disabled = true;
                            espnPollBtn.textContent = 'Polling...';
                            resultsWrapper.style.display = 'none';

                            try {
                                const dateInput = document.getElementById('espnPollDate');
                                const dateVal = dateInput && dateInput.value ? dateInput.value.replace(/-/g, '') : null;
                                const body = dateVal ? JSON.stringify({ dateStr: dateVal }) : null;
                                const response = await fetch('/admin/trigger-espn-poll', {
                                    method: 'POST',
                                    headers: { 'x-csrf-token': '<%= csrfToken %>', 'Accept': 'application/json', ...(body ? { 'Content-Type': 'application/json' } : {}) },
                                    ...(body ? { body } : {}),
                                });
                                const data = await response.json();

                                const nodes = [];
                                if (!response.ok) {
                                    nodes.push(makeSpan('text-danger', `Error: ${data.error || 'Unknown error'}`));
                                } else if (data.games.length === 0) {
                                    nodes.push(makeSpan('text-muted', 'No new completed games found.'));
                                } else {
                                    const roundLabel = (r) => ({0: 'FF', 1: 'R1', 2: 'R2', 3: 'Sweet 16', 4: 'Elite 8', 5: 'Final Four', 6: 'Championship'}[r] ?? `R${r}`);
                                    const heading = document.createElement('strong');
                                    heading.textContent = 'ESPN says these games are done:';
                                    const ul = document.createElement('ul');
                                    ul.className = 'mb-1 mt-1 list-unstyled';
                                    data.games.forEach(g => {
                                        const li = document.createElement('li');
                                        li.className = 'd-flex align-items-center gap-2 mb-1';

                                        const span = document.createElement('span');
                                        const winner = document.createElement('strong');
                                        winner.textContent = g.winnerDisplayName ?? '';
                                        span.append(`${roundLabel(g.round)} · Game ${g.gameID}: `, winner, ' wins');

                                        const btn = document.createElement('button');
                                        btn.className = 'btn btn-sm btn-success espn-submit-btn';
                                        btn.textContent = 'Submit';
                                        btn.dataset.gameId = g.gameID;
                                        btn.dataset.round = g.round;
                                        btn.dataset.winnerId = g.winnerSID;
                                        btn.dataset.winnerName = g.winnerDisplayName ?? '';
                                        btn.dataset.team1Id = g.team1ID;
                                        btn.dataset.team2Id = g.team2ID;
                                        btn.dataset.nextGameId = g.nextGameID ?? '';
                                        btn.dataset.nextGameSpot = g.nextGameSpot ?? '';

                                        li.append(span, btn);
                                        ul.appendChild(li);
                                    });
                                    nodes.push(heading, ul);
                                }
                                if (data.unmapped && data.unmapped.length > 0) {
                                    nodes.push(makeSpan('text-warning', `Unmapped teams (update espnTeamMap.json): ${data.unmapped.join(', ')}`));
                                }

                                resultsInner.replaceChildren(...nodes);
                                resultsWrapper.style.display = 'block';
                            } catch (error) {
                                resultsInner.replaceChildren(makeSpan('text-danger', 'Failed to reach server.'));
                                resultsWrapper.style.display = 'block';
                            } finally {
                                espnPollBtn.disabled = false;
                                espnPollBtn.textContent = 'Poll ESPN';
                            }
                        });
                    }

                    document.getElementById('espnPollResultsInner').addEventListener('click', async (e) => {
                        const btn = e.target.closest('.espn-submit-btn');
                        if (!btn) return;

                        btn.disabled = true;
                        btn.textContent = 'Submitting...';

                        const gameData = {
                            gameID: btn.dataset.gameId,
                            round: btn.dataset.round,
                            winnerID: btn.dataset.winnerId,
                            winnerName: btn.dataset.winnerName,
                            team1ID: btn.dataset.team1Id,
                            team2ID: btn.dataset.team2Id,
                            nextGameID: btn.dataset.nextGameId,
                            nextGameSpot: btn.dataset.nextGameSpot,
                            year: currentYear
                        };

                        try {
                            const response = await fetch('/updateWinner', {
                                method: 'POST',
                                headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify(gameData)
                            });
                            if (response.ok) {
                                btn.textContent = 'Done';
                                btn.classList.replace('btn-success', 'btn-secondary');
                            } else {
                                btn.textContent = 'Error';
                                btn.classList.replace('btn-success', 'btn-danger');
                                btn.disabled = false;
                            }
                        } catch (error) {
                            btn.textContent = 'Error';
                            btn.classList.replace('btn-success', 'btn-danger');
                            btn.disabled = false;
                        }
                    });

                    const gamesTable = document.getElementById('gamesTable');
                    const toggleDetailsBtn = document.getElementById('toggleDetailsBtn');
                    if (gamesTable && toggleDetailsBtn) {
                        const STORAGE_KEY = 'adminGamesCompact';
                        const setCompact = (compact) => {
                            gamesTable.classList.toggle('games-compact', compact);
                            document.getElementById('regcont').classList.toggle('games-compact', compact);
                            // Group headings span the columns still visible.
                            gamesTable.querySelectorAll('th[data-span-full]').forEach(th => {
                                th.colSpan = Number(compact ? th.dataset.spanShort : th.dataset.spanFull);
                            });
                            toggleDetailsBtn.textContent = compact ? 'Show more' : 'Show less';
                            toggleDetailsBtn.setAttribute('aria-expanded', String(!compact));
                        };
                        let saved = false;
                        try { saved = localStorage.getItem(STORAGE_KEY) === '1'; } catch (e) { /* storage blocked */ }
                        setCompact(saved);
                        toggleDetailsBtn.addEventListener('click', () => {
                            const compact = !gamesTable.classList.contains('games-compact');
                            setCompact(compact);
                            try { localStorage.setItem(STORAGE_KEY, compact ? '1' : '0'); } catch (e) { /* storage blocked */ }
                        });
                    }

                    const gameRows = document.querySelectorAll('.game-row');

                    let maxRound = 0;
                    gameRows.forEach(row => {
                        const round = parseInt(row.dataset.round);
                        if (round > maxRound) maxRound = round;
                    });

                    const applyStripedStyling = () => {
                        const visibleRows = Array.from(document.querySelectorAll('.table tbody tr'))
                            .filter(row => row.style.display !== 'none');
                        visibleRows.forEach((row, index) => {
                            if (index % 2 === 0) {
                                row.classList.add('table-striped');
                                row.classList.remove('table-secondary');
                            } else {
                                row.classList.remove('table-striped');
                                row.classList.add('table-secondary');
                            }
                        });
                    };
                    applyStripedStyling();

                    gameRows.forEach((row) => {
                        const round = parseInt(row.dataset.round);
                        const nextGameID = row.dataset.nextGameId || '';

                        let hideRow = false;

                        if (round !== maxRound && round !== maxRound - 1) {
                            hideRow = true;
                        }

                        if (nextGameID !== "") {
                            const nextGameRows = Array.from(gameRows).filter(r => r.dataset.gameId === nextGameID);
                            if (nextGameRows && nextGameRows.length > 0) {
                                const nextGameRow = nextGameRows[0];
                                if (nextGameRow.dataset.winnerId) {
                                    hideRow = true;
                                }
                            }
                        }

                        if (hideRow) {
                            if (row.classList.contains('d-flex') || row.classList.contains('card')) {
                                row.classList.remove('d-flex');
                                row.style.setProperty('display', 'none', 'important');
                            } else {
                                row.style.display = 'none';
                            }
                        }
                    });
                    applyStripedStyling();

                    const toast = document.getElementById('resultToast');
                    const toastMsg = document.getElementById('resultToastMsg');
                    const toastAction = document.getElementById('resultToastAction');
                    const TOAST_MS = 8000;
                    let toastTimer = null;
                    let toastActionFn = null;
                    let inFlight = false;
                    // A saved result leaves the rest of the page (next-round games, row hiding) stale until reload.
                    let dirty = false;

                    const hideToast = () => {
                        clearTimeout(toastTimer);
                        toast.hidden = true;
                        toastActionFn = null;
                    };
                    const showToast = (message, { actionLabel = '', onAction = null, error = false } = {}) => {
                        clearTimeout(toastTimer);
                        toastMsg.textContent = message;
                        toast.classList.toggle('is-error', error);
                        toastAction.hidden = !actionLabel;
                        toastAction.textContent = actionLabel;
                        toastActionFn = onAction;
                        toast.hidden = false;
                        toastTimer = setTimeout(() => {
                            hideToast();
                            if (dirty && !inFlight) window.location.reload();
                        }, TOAST_MS);
                    };
                    toastAction.addEventListener('click', () => {
                        const fn = toastActionFn;
                        hideToast();
                        if (fn) fn();
                    });

                    // Results are applied one at a time: concurrent writes could race on a shared next-game slot or the points recompute.
                    const setBusy = (busy) => {
                        inFlight = busy;
                        document.querySelectorAll('.game-row button:not(.team-pick-btn)').forEach(b => { b.disabled = busy; });
                    };
                    const postResult = async (url, row, winnerID, winnerName) => {
                        try {
                            const response = await fetch(url, {
                                method: 'POST',
                                headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({
                                    gameID: row.dataset.gameId, regionID: row.dataset.region, round: row.dataset.round,
                                    team1ID: row.dataset.team1Id, team1Name: row.dataset.team1Name,
                                    team2ID: row.dataset.team2Id, team2Name: row.dataset.team2Name,
                                    nextGameID: row.dataset.nextGameId, nextGameSpot: row.dataset.nextGameSpot,
                                    winnerID, winnerName, year: currentYear
                                })
                            });
                            return response.ok;
                        } catch (error) {
                            return false;
                        }
                    };
                    // Each game renders twice (desktop table + mobile card), so update every copy.
                    const setGameState = (gameID, winnerID) => {
                        const decided = Boolean(winnerID);
                        document.querySelectorAll(`.game-row[data-game-id="${gameID}"]`).forEach(r => {
                            r.dataset.winnerId = decided ? winnerID : '';
                            r.querySelectorAll('.team-pick-btn').forEach(b => {
                                const isWinner = decided && b.dataset.teamId === String(winnerID);
                                b.classList.toggle('is-winner', isWinner);
                                b.classList.toggle('is-loser', decided && !isWinner);
                            });
                            r.querySelector('.undo-game-result').classList.toggle('d-none', !decided);
                            const hold = r.querySelector('.release-hold-btn');
                            if (hold) hold.classList.toggle('d-none', decided);
                        });
                    };

                    const submitPick = async (row, winnerID, winnerName) => {
                        if (inFlight) return;
                        hideToast();
                        setBusy(true);
                        const ok = await postResult('/updateWinner', row, winnerID, winnerName);
                        setBusy(false);
                        if (!ok) {
                            showToast(`Couldn't save game ${row.dataset.gameId}. Try again.`, { error: true });
                            return;
                        }
                        dirty = true;
                        setGameState(row.dataset.gameId, winnerID);
                        showToast(`${winnerName} wins`, { actionLabel: 'Undo', onAction: () => submitUndo(row) });
                    };

                    const submitUndo = async (row) => {
                        const winnerID = row.dataset.winnerId;
                        if (inFlight || !winnerID) return;
                        const winnerName = winnerID === row.dataset.team1Id ? row.dataset.team1Name : row.dataset.team2Name;
                        hideToast();
                        setBusy(true);
                        const ok = await postResult('/undoGame', row, winnerID, winnerName);
                        setBusy(false);
                        if (!ok) {
                            showToast(`Couldn't undo game ${row.dataset.gameId}. Try again.`, { error: true });
                            return;
                        }
                        dirty = true;
                        setGameState(row.dataset.gameId, null);
                        showToast(`Game ${row.dataset.gameId} undone`, {
                            actionLabel: 'Redo',
                            onAction: () => submitPick(row, winnerID, winnerName)
                        });
                    };

                    document.addEventListener('click', (e) => {
                        const pick = e.target.closest('.team-pick-btn');
                        if (pick) {
                            const row = pick.closest('.game-row');
                            if (!row.dataset.winnerId) submitPick(row, pick.dataset.teamId, pick.dataset.teamName);
                            return;
                        }
                        const undo = e.target.closest('.undo-game-result');
                        if (undo) submitUndo(undo.closest('.game-row'));
                    });

                    gameRows.forEach((row) => {
                        const gameID = row.dataset.gameId;
                        const releaseHoldButton = row.querySelector('.release-hold-btn');
                        if (releaseHoldButton) {
                            releaseHoldButton.addEventListener('click', async () => {
                                if (!window.confirm(`Release the poll hold on game ${gameID}? The ESPN poll may immediately re-apply the result from its feed.`)) return;
                                releaseHoldButton.disabled = true;
                                try {
                                    const response = await fetch('/releaseGameHold', {
                                        method: 'POST',
                                        headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                        body: JSON.stringify({ gameID, year: currentYear })
                                    });
                                    if (response.ok) {
                                        alert('Hold released. The page will refresh on OK.');
                                        window.location.reload();
                                    } else {
                                        alert('Error releasing hold. Please try again.');
                                        releaseHoldButton.disabled = false;
                                    }
                                } catch (error) {
                                    console.error('Error releasing hold:', error);
                                    alert('Network error releasing hold. Please try again.');
                                    releaseHoldButton.disabled = false;
                                }
                            });
                        }
                    });
                });

                function refreshPage() {
                    window.location.reload();
                }
            </script>

    </body>

</html>