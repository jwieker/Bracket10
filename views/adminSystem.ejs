<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/admin-header') %>
    <title>System — Admin</title>
</head>

<% const adminSection = 'system'; %>

<body>
    <%- include('partials/admin-nav', { year, adminSection }) %>

    <div class="container-lg pb-5">

        <div class="row g-4">

            <!-- Change Year -->
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Active Year</div>
                    <div class="card-body">
                        <form action="/changeYear" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="input-group">
                                <input type="text" name="year" class="form-control" value="<%= year %>" aria-label="Year">
                                <button class="btn btn-outline-secondary" type="submit">Update Year</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Update Total Points -->
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Recalculate Scores</div>
                    <div class="card-body d-flex align-items-center">
                        <form action="/updateTotalPoints" method="post" class="w-100">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="year" value="<%= year %>">
                            <button class="btn btn-outline-secondary w-100" type="submit">Update Total Points</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Clear Cache -->
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Cache</div>
                    <div class="card-body d-flex align-items-center">
                        <form id="clearCacheForm" class="w-100">
                            <input type="hidden" name="year" value="<%= year %>">
                            <button class="btn btn-outline-danger w-100 clear-cache-btn" type="button" id="clearCacheBtn">Clear Cache</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Clear Google Sign-in Sessions -->
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-header fw-semibold">Google Sign-in Sessions</div>
                    <div class="card-body d-flex flex-column align-items-start">
                        <div class="w-100">
                            <button class="btn btn-outline-danger w-100" type="button" id="clearGoogleSessionsBtn">Clear Google Sign-Ins</button>
                        </div>
                        <!-- Default scope preserves an admin console session merged onto the
                             same session doc as a participant login (#428) — only check this
                             for a real incident response that must also sign out admins. -->
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="clearGoogleSessionsIncludeAdmins">
                            <label class="form-check-label" for="clearGoogleSessionsIncludeAdmins">
                                Also sign out admin console sessions
                            </label>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div>
        <%- include('partials/rulesModal') %>
        <%- include('partials/scripts') %>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const clearCacheBtn = document.getElementById('clearCacheBtn');
            const clearCacheForm = document.getElementById('clearCacheForm');
            const clearGoogleSessionsBtn = document.getElementById('clearGoogleSessionsBtn');
            const clearGoogleSessionsIncludeAdmins = document.getElementById('clearGoogleSessionsIncludeAdmins');

            if (clearCacheBtn) {
                clearCacheBtn.addEventListener('click', async () => {
                    if (confirm("Are you sure you want to clear the cache?")) {
                        const formData = new FormData(clearCacheForm);
                        const data = Object.fromEntries(formData.entries());

                        try {
                            const response = await fetch('/clearCache', {
                                method: 'POST',
                                headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify(data)
                            });
                            if (response.ok) {
                                const responseData = await response.json();
                                alert(responseData);
                                window.location.reload();
                            } else {
                                alert('Failed to clear cache. Server error.');
                            }
                        } catch (error) {
                            console.error("Error clearing cache:", error);
                            alert('An error occurred while clearing the cache.');
                        }
                    }
                });
            }

            if (clearGoogleSessionsBtn) {
                clearGoogleSessionsBtn.addEventListener('click', async () => {
                    const includeAdmins = !!clearGoogleSessionsIncludeAdmins?.checked;
                    const confirmMsg = includeAdmins
                        ? "Are you sure you want to clear all Google sign-in sessions, including other admins' console sessions? You will be signed out."
                        : "Are you sure you want to clear all Google sign-in sessions? You will be signed out.";
                    if (confirm(confirmMsg)) {
                        try {
                            const response = await fetch('/clearGoogleSessions', {
                                method: 'POST',
                                headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: JSON.stringify({ includeAdmins })
                            });
                            if (response.ok) {
                                const responseData = await response.json();
                                alert(responseData);
                                window.location.href = '/updates';
                            } else {
                                alert('Failed to clear Google sign-in sessions. Server error.');
                            }
                        } catch (error) {
                            console.error("Error clearing Google sessions:", error);
                            alert('An error occurred while clearing Google sign-in sessions.');
                        }
                    }
                });
            }
        });
    </script>

</body>

</html>
