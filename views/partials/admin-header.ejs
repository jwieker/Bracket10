<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0d6efd">
<title>Bracket 10</title>
<link rel="manifest" href="/admin-manifest.json">
<!-- Resolve the color theme BEFORE first paint: saved choice → OS preference → light. -->
<script nonce="<%= cspNonce %>">(function(){try{var t=localStorage.getItem('theme');if(t!=='light'&&t!=='dark'){t=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';}document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}catch(e){document.documentElement.setAttribute('data-theme','light');document.documentElement.style.colorScheme='light';}}());</script>
<!-- Warm up CDN connections so first-visit (uncached) assets paint sooner -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://ajax.googleapis.com" crossorigin>
<!-- Bootstrap 5.3.3 — loaded BEFORE our custom stylesheets so our tokens win the cascade -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="/tokens.css">
<link rel="stylesheet" href="/style.css">
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Bracket 10</a>
        <nav class="mode-switcher" aria-label="Color mode">
            <button class="mode-btn" id="theme-light" aria-label="Light mode">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="8" cy="8" r="3.5"/>
                    <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.9 11.9l1.06 1.06M3.05 12.95l1.06-1.06M11.9 4.1l1.06-1.06"/>
                </svg>
                Light
            </button>
            <button class="mode-btn" id="theme-dark" aria-label="Dark mode">
                <svg viewBox="0 0 16 16" fill="currentColor">
                    <path d="M13.5 10.5A5.5 5.5 0 0 1 6 3.2a.5.5 0 0 0-.6-.65A6.5 6.5 0 1 0 13.95 11a.5.5 0 0 0-.45-.5z"/>
                </svg>
                Dark
            </button>
        </nav>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto"> <!-- ms-auto pushes items to the right -->
                <li class="nav-item">
                    <a class="nav-link" aria-current="page" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#rulesModal">Rules</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link external-link" href="https://www.ncaa.com/brackets/print/basketball-men/d1/2026"
                        target="_blank" rel="noopener noreferrer" aria-label="Full Bracket (opens in a new tab)">
                        Full Bracket
                        <svg class="external-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>

                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                        href="https://docs.google.com/forms/d/e/1FAIpQLSfs73k2XVvEOxg-NTUYuDg3AyiM1H7SIBOOjvDm2AEkzd-YJA/viewform?usp=header">Feedback
                        <svg class="external-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg></a>

                </li>
            </ul>
        </div>
    </div>
</nav>


<style>
    .external-icon {
        width: 0.8em;
        height: 0.8em;
        margin-left: 1px;
        vertical-align: .125em;
    }
</style>

<script nonce="<%= cspNonce %>">
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/admin-service-worker.js', { scope: "/updates" })
                .then(registration => {
                    console.log('Service Worker registered with scope:', registration.scope);
                })
                .catch(error => {
                    console.log('Service Worker registration failed:', error);
                });
        });
    }
</script>
<script nonce="<%= cspNonce %>">
(function () {
    var root = document.documentElement;
    // persist=true only on an explicit click, so visitors who never pick a theme
    // keep following their OS preference on future visits.
    function applyTheme(dark, persist) {
        var t = dark ? 'dark' : 'light';
        root.setAttribute('data-theme', t);
        root.style.colorScheme = t;
        if (persist) { try { localStorage.setItem('theme', t); } catch (e) {} }
        document.getElementById('theme-light').classList.toggle('active', !dark);
        document.getElementById('theme-dark').classList.toggle('active', dark);
    }
    document.getElementById('theme-light').addEventListener('click', function () { applyTheme(false, true); });
    document.getElementById('theme-dark').addEventListener('click', function () { applyTheme(true, true); });
    applyTheme(root.getAttribute('data-theme') === 'dark', false);
}());
</script>