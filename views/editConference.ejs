<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
        <title>
            <%= isNew ? 'Add Conference' : 'Edit Conference' %>
        </title>
</head>

<body>
    <div class="container-lg pt-3">
        <div class="row">
            <div
                class="col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 border border-dark border-2 p-0">
                <div class="mb-2 pt-3 fs-3 fw-bold text-center">
                    <%= isNew ? 'Add Conference' : 'Edit Conference' %>
                        <% if (!isNew) { %><br><small
                                class="fs-6 text-muted"><code><%= conference.slug %></code></small>
                            <% } %>
                </div>

                <form action="<%= isNew ? '/addConference' : '/updateConference' %>" method="post" class="p-3">
                    <!-- Slug: editable on add, hidden on edit -->
                    <% if (isNew) { %>
                        <div class="mb-3">
                            <label for="inputSlug" class="form-label">Slug <small class="text-muted">(unique identifier,
                                    e.g. <code>big-east</code>)</small></label>
                            <input type="text" name="slug" id="inputSlug" class="form-control"
                                placeholder="e.g. big-east" required pattern="[a-z0-9\-]+"
                                title="Lowercase letters, numbers and hyphens only">
                        </div>
                        <% } else { %>
                            <input type="hidden" name="slug" value="<%= conference.slug %>">
                            <% } %>

                                <div class="mb-3">
                                    <label for="inputName" class="form-label">Full Name</label>
                                    <input type="text" name="name" id="inputName" class="form-control"
                                        value="<%= conference.name %>" required placeholder="e.g. Big East Conference">
                                </div>

                                <div class="mb-3">
                                    <label for="inputShortName" class="form-label">Short Name</label>
                                    <input type="text" name="shortName" id="inputShortName" class="form-control"
                                        value="<%= conference.shortName %>" placeholder="e.g. Big East">
                                </div>

                                <div class="mb-3">
                                    <label for="inputDivision" class="form-label">Division</label>
                                    <select name="division" id="inputDivision" class="form-select">
                                        <option value="I" <%=(conference.division==='I' ) ? 'selected' : '' %>>Division
                                            I</option>
                                        <option value="II" <%=(conference.division==='II' ) ? 'selected' : '' %>
                                            >Division II</option>
                                        <option value="III" <%=(conference.division==='III' ) ? 'selected' : '' %>
                                            >Division III</option>
                                    </select>
                                </div>

                                <div class="mb-3 form-check">
                                    <input type="checkbox" name="active" id="inputActive" class="form-check-input"
                                        value="true" <%=conference.active ? 'checked' : '' %>>
                                    <label class="form-check-label" for="inputActive">Active</label>
                                    <div class="form-text">Inactive conferences still appear in history but won't appear
                                        at the top of dropdowns.</div>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <%= isNew ? 'Add Conference' : 'Save Changes' %>
                                    </button>
                                    <a href="/conferences" class="btn btn-outline-secondary">← Back to Conferences</a>
                                </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        <%- include('partials/rulesModal') %>
            <%- include('partials/scripts') %>
    </div>
</body>

</html>