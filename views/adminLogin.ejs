<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/admin-header') %>

</head>

<body class="bg-body-tertiary">
    <div class="login-wrapper">
        <main class="form-signin w-100 m-auto" style="max-width: 400px;">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h2 class="h3 mb-3 fw-normal">Admin Access</h2>
                        <p class="text-muted">Sign in to manage the tournament</p>
                    </div>

                    <form action="/auth/google/start" method="get" class="d-grid gap-3 mb-3">
                        <div class="form-check text-start">
                            <input class="form-check-input" type="checkbox" id="rememberMe" name="remember" value="1" checked>
                            <label class="form-check-label" for="rememberMe">Remember me for 30 days</label>
                        </div>
                        <button type="submit" class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            Sign in with Google
                        </button>
                    </form>
                    <div class="mt-4 text-center">
                        <a href="/" class="text-decoration-none text-muted small">&larr; Back to Main Site</a>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>
