<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
        <!-- sorting -->
        <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/tablesort@5.3.0/dist/tablesort.min.js"
            integrity="sha384-vhcBfNt762rNlbnxZsIJQSPWX7b+8NzToPmcW6J5cJzXSnOjZKS2LQ/O2uqLlHcX" crossorigin="anonymous"></script>
        <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/tablesort@5.3.0/dist/sorts/tablesort.number.min.js"
            integrity="sha384-yt4K6HL9dLK27YW0wB3TsVyPTrtPn6Nk/l6dsN6bA7UPj+dnl1qMC+Ia2udCYEz1" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/table-styles.css">
        <style>
            .team-logo-box {
                width: 30px;
                height: 30px;
                border-radius: 4px;
                border-width: 2px;
                border-style: solid;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--bg-soft);
                overflow: hidden;
                flex-shrink: 0;
            }
            .team-logo-box img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
            .team-logo-fallback {
                font-size: 0.6rem;
                font-weight: 700;
                color: var(--text-muted);
                text-align: center;
                line-height: 1;
            }
            #groupTable thead tr:nth-child(2) th,
            #groupTable thead th.grid-label-col {
                vertical-align: bottom;
            }
        </style>
</head>

<body>
    <div class="container-fluid pt-2 pb-5 px-xl-5">

        <div class="card-table-container">
            <div class="card-table-header flex-column flex-sm-row gap-3">
                <form action="/gameView" method="POST" class="m-0">
                    <input type="hidden" name="game" value="<%= groupName %>">
                    <input type="hidden" name="year" value="<%= gameYear %>">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-2 fw-semibold"
                        style="color: var(--text-main); font-size: 1.0625rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                            viewBox="0 0 16 16">
                            <path fill-rule="evenodd"
                                d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                        </svg>
                        Back to Results for group: <%= groupName %> (<%= groupData.length %>)
                    </button>
                </form>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <button id="toggleHiddenStats" class="btn btn-sm text-white px-3 py-2 btn-primary">Show
                        More Stats</button>
                    <button id="toggleEliminated" class="btn btn-sm text-white px-3 py-2 btn-primary">Hide
                        Eliminated</button>
                    <a href="/getFullGridCSV?gameName=<%= encodeURIComponent(groupName) %>&gameYear=<%= gameYear %>"
                        class="btn btn-sm btn-primary px-3 py-2">Get Spreadsheet</a>
                    <a href="/playground?group=<%= encodeURIComponent(groupName) %>&year=<%= gameYear %>"
                        class="btn btn-sm btn-warning px-3 py-2">Playground <span class="badge bg-dark text-white ms-1" style="font-size:.65rem">BETA</span></a>
                </div>
            </div>

            <!-- Mobile Card View (Visible only on small screens) -->
            <div class="d-md-none bg-light p-2 shadow-inner">
                <% groupData.forEach((group, index)=> { %>
                    <div class="mobile-entry-card">
                        <div class="mobile-entry-header">
                            <div class="d-flex align-items-center">
                                <span class="mobile-rank me-3">#<%= group.rank || (index + 1) %></span>
                                <div>
                                    <div class="mobile-entry-name">
                                        <%= group.person %>
                                    </div>
                                    <div class="text-muted small">
                                        <%= group.teamName %>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="stat-value text-primary">
                                    <%= group.totalPoints %>
                                </div>
                                <div class="stat-label">Pts</div>
                            </div>
                        </div>

                        <div class="mt-2 mb-2">
                            <div class="stat-label mb-1">Teams Remaining: <strong>
                                    <%= group.teamsRemaining %><% if (group.teamsAdvanced > 0) { %> <span style="white-space:nowrap">(<%= group.teamsAdvanced %> adv)</span><% } %>
                                </strong></div>
                            <div class="d-flex flex-wrap gap-1">
                                <% allTeams.forEach(team=> { %>
                                    <% if (group.pickIndexBySID.has(team.sID)) { %>

                                        <span
                                            class="badge rounded-pill <%= (team.gameStatus && team.gameStatus[team.gameStatus.length - 1]==='L') ? 'bg-danger' : 'bg-success' %>">
                                            <%= team.name %>
                                        </span>
                                        <% } %>
                                            <% }); %>
                            </div>
                        </div>

                        <div class="mobile-stats-grid mobile-hidden-stats">
                            <div class="stat-item">
                                <div class="stat-value">
                                    <%= group.possPoints %>
                                </div>
                                <div class="stat-label"
                                    title="Current Points + Points achievable if all remaining teams win.">Max Score ⓘ
                                </div>
                            </div>
                            <div class="stat-item">
                                <div class="stat-value">
                                    <%= (typeof group.highestPlace !=='undefined' ? group.highestPlace : '-' ) + (typeof
                                        group.ties !=='undefined' && group.ties> 0 ? ' (' + group.ties + ')' : '') %>
                                </div>
                                <div class="stat-label"
                                    title="Highest Possible Rank (Ties in parentheses) if all remaining teams win.">Best
                                    Rank ⓘ</div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>

            <!-- Desktop Table View (Hidden on mobile) -->
            <div class="table-responsive table-scroll-full-grid d-none d-md-block w-100"
                data-mdb-perfect-scrollbar="true" style="position: relative; max-height: 82vh">
                <table class="table custom-card-table table-hover mb-0" id="groupTable">
                    <thead>
                        <tr>
                            <th style="min-width: 200px; z-index: 30;" class="full-grid-sticky-1 grid-label-col">Entry</th>
                            <th class="full-grid-sticky-1 grid-label-col" data-sort-method="number">Rank</th>
                            <th data-sort-default data-sort-method="number" class="full-grid-sticky-1 grid-label-col">Points</th>
                            <th class="full-grid-sticky-1 grid-label-col" data-sort-method="number">Teams Rem.</th>
                            <th class="full-grid-sticky-1 grid-label-col" data-sort-method="number" title="Number of your remaining teams that have won a game in the current round.">Adv. ⓘ</th>
                            <th class="eliminated-noline full-grid-sticky-1 grid-label-col"
                                title="Highest Possible Rank (Ties in parentheses) if all remaining teams win.">Best Rank ⓘ</th>
                            <th class="eliminated-noline full-grid-sticky-1 grid-label-col" data-sort-method="number"
                                title="Current Points + Points achievable if all remaining teams win.">Max Score ⓘ</th>
                            <%
                                let minActiveGsLen = Infinity;
                                let maxActiveGsLen = 0;
                                allTeams.forEach(t => {
                                    const gs = t.gameStatus;
                                    if (gs && gs[gs.length - 1] !== 'L') {
                                        minActiveGsLen = Math.min(minActiveGsLen, gs.length);
                                        maxActiveGsLen = Math.max(maxActiveGsLen, gs.length);
                                    }
                                });
                                const roundInProgress = maxActiveGsLen > minActiveGsLen;
                            %>
                            <% allTeams.forEach(team=> { %>
                                <% const gs = team.gameStatus; const teamAdvanced = roundInProgress && gs && gs.length === maxActiveGsLen && gs[gs.length - 1] === 'W'; %>
                                <th <% if (team.gameStatus && team.gameStatus[team.gameStatus.length - 1]==='L' ) { %>
                                    class="eliminated text-muted full-grid-sticky-1" title="Eliminated"
                                    <% } else { %>
                                        class="full-grid-sticky-1"
                                        <% } %>>
                                            <div class="text-center d-flex flex-column align-items-center gap-1">
                                                <div class="d-flex align-items-center gap-1">
                                                    <span class="badge bg-light text-dark" style="font-size:0.6rem;"><%= team.seed %></span>
                                                    <small class="text-muted" style="font-size:0.6rem; white-space:nowrap;"><%= team.regionName %></small>
                                                </div>
                                                <div class="team-logo-box" data-border-color="<%= team.primaryColor ? '#' + team.primaryColor : '#ccc' %>">
                                                    <% if (team.logoUrl) { %>
                                                        <img src="<%= team.logoUrl %>" alt="<%= team.name %>" loading="lazy">
                                                    <% } else { %>
                                                        <span class="team-logo-fallback"><%= (team.nameNick || team.name || '?').substring(0, 2).toUpperCase() %></span>
                                                    <% } %>
                                                </div>
                                                <div style="font-size:0.7rem; line-height:1.1;"><%= team.nameNick || team.name %></div>
                                                <div class="team-pick-count"><%= team.pickCount %><% if (teamAdvanced) { %><span class="text-success fw-bold" style="font-size:0.65rem"> A</span><% } %></div>
                                            </div>
                                </th>
                                <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% groupData.forEach(group=> { %>
                            <tr>
                                <td class="fw-bold text-md-nowrap">
                                    <% const MAX_NAME_DISPLAY=40; const fullGridText=group.person + " - " +
                                        group.teamName; const displayGridText=fullGridText.length> MAX_NAME_DISPLAY ?
                                        fullGridText.substring(0, MAX_NAME_DISPLAY) + "..."
                                        : fullGridText;
                                        %>
                                        <%= displayGridText %>
                                </td>
                                <td></td> <!-- Rank populated by JS -->
                                <td class="fw-bold text-primary">
                                    <%= group.totalPoints %>
                                </td>
                                <td>
                                    <%= group.teamsRemaining %>
                                </td>
                                <td>
                                    <%= group.teamsAdvanced || 0 %>
                                </td>
                                <td class="eliminated-noline" data-sort="<%= typeof group.highestPlace !=='undefined' ? group.highestPlace : 999 %>">
                                    <%= (typeof group.highestPlace !=='undefined' ? group.highestPlace : '-' ) + (typeof
                                        group.ties !=='undefined' && group.ties> 0 ? ' (' + group.ties + ')' : '') %>
                                </td>
                                <td class="eliminated-noline">
                                    <%= group.possPoints %>
                                </td>

                                <% allTeams.forEach(team=> { %>
                                    <td <% if (team.gameStatus && team.gameStatus[team.gameStatus.length - 1]==='L' ) {
                                        %>
                                        class="eliminated bg-light" title="Eliminated"
                                        <% } %>>
                                            <% const pickPosition = group.pickIndexBySID.get(team.sID);
                                                %>
                                                <% if (pickPosition) { %>

                                                    <% if (team.gameStatus && team.gameStatus[team.gameStatus.length -
                                                        1]==='L' ) { %>
                                                        <span class="text-danger fw-bold">
                                                            <%= pickPosition %>
                                                        </span>
                                                        <% } else { %>
                                                            <span class="text-success fw-bold">
                                                                <%= pickPosition %>
                                                            </span>
                                                            <% } %>

                                                                <% } %>
                                    </td>
                                    <% }); %>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div> <!-- end card-table-container -->
    </div>

    <div>
        <%- include('partials/rulesModal') %> <%- include('partials/scripts') %>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', function () {
            // Apply team logo border colors from data attribute (avoids EJS-in-CSS lint error)
            document.querySelectorAll('.team-logo-box[data-border-color]').forEach(el => {
                el.style.borderColor = el.dataset.borderColor;
            });

            const toggleButton = document.getElementById('toggleEliminated');
            const toggleButtonStats = document.getElementById('toggleHiddenStats');

            // Select both desktop and mobile elements if needed, though mostly for table
            const eliminatedColumns = document.querySelectorAll('th.eliminated, td.eliminated');
            const hiddenStats = document.querySelectorAll('th.eliminated-noline, td.eliminated-noline, .mobile-hidden-stats');

            const groupTable = document.getElementById('groupTable');

            // Sorting Logic (Preserved and optimized)
            if (groupTable) {
                const tableSort = new Tablesort(groupTable);

                const customSort = (a, b) => {
                    // Adjust indices based on new HTML structure if needed
                    // Note: children indices might shift if we changed column order
                    // Current order: Entry(0), Rank(1), Points(2), TeamsRem(3), Adv(4), PotRank(5), MaxPts(6)

                    const totalPointsA = parseFloat(a.children[2].textContent);
                    const totalPointsB = parseFloat(b.children[2].textContent);
                    const teamsRemainingA = parseFloat(a.children[3].textContent);
                    const teamsRemainingB = parseFloat(b.children[3].textContent);
                    const maxPossibleA = parseFloat(a.children[6].textContent);
                    const maxPossibleB = parseFloat(b.children[6].textContent);

                    if (totalPointsA !== totalPointsB) return totalPointsB - totalPointsA;
                    if (teamsRemainingA !== teamsRemainingB) return teamsRemainingB - teamsRemainingA;
                    return maxPossibleB - maxPossibleA;
                };

                const rows = Array.from(groupTable.tBodies[0].rows);
                rows.sort(customSort);
                rows.forEach(row => groupTable.tBodies[0].appendChild(row));

                // Re-calculate Ranks
                let rank = 0;
                let previousTotalPoints = -1;
                let previousRank = 0;
                let sameRankCount = 0;

                rows.forEach((row, index) => {
                    const currentTotalPoints = parseFloat(row.children[2].textContent);
                    if (currentTotalPoints === previousTotalPoints) {
                        sameRankCount++;
                        row.children[1].textContent = previousRank;
                    } else {
                        rank += sameRankCount + 1;
                        sameRankCount = 0;
                        row.children[1].textContent = rank;
                        previousRank = rank;
                    }
                    previousTotalPoints = currentTotalPoints;
                });
            }

            // Toggle Logic
            // Hide columns initially
            eliminatedColumns.forEach(column => column.style.display = 'none');
            toggleButton.textContent = 'Show Eliminated';

            toggleButton.addEventListener('click', () => {
                const isHidden = toggleButton.textContent === 'Show Eliminated';
                eliminatedColumns.forEach(column => {
                    if (isHidden) {
                        // Show all
                        column.style.display = '';
                    } else {
                        // Hide ONLY if it's an eliminated column (checking class)
                        // Logic preserved from original: hide if it doesn't contain the 'eliminated' marker?
                        // Actually, original logic was: if showing, show all. If hiding, hide only if no 'X' inside?
                        // Let's simplify: Just toggle visibility of the column class
                        column.style.display = 'none';
                    }
                });

                // Re-apply the logic to ONLY hide empty eliminated columns if that was the intent?
                // The original code had a specific check: if (!column.querySelector('.eliminated'))
                // But here we selected ALL .eliminated columns. 
                // Let's stick to simple toggle for now to ensure UI responsiveness.
                if (isHidden) {
                    toggleButton.textContent = 'Hide Eliminated';
                    eliminatedColumns.forEach(c => c.style.display = '');
                } else {
                    toggleButton.textContent = 'Show Eliminated';
                    eliminatedColumns.forEach(c => c.style.display = 'none');
                }
            });

            hiddenStats.forEach(column => column.style.display = 'none');
            toggleButtonStats.textContent = 'Show More Stats';

            toggleButtonStats.addEventListener('click', () => {
                const isHidden = toggleButtonStats.textContent === 'Show More Stats';
                hiddenStats.forEach(column => column.style.display = isHidden ? '' : 'none');
                toggleButtonStats.textContent = isHidden ? 'Hide More Stats' : 'Show More Stats';
            });
        });
    </script>
</body>

</html>