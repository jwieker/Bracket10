<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/admin-header') %>
</head>


<body>
    <div class="container-l pt-1" id="regcont">
        <div class="row" id="row1">
            <!-- <div class="col" id="col1"></div> -->

            <div class="col-sm-10 offset-sm-1 col-md-10 offset-md-1 col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 pl-1 pr-1 mt-2 mb-2 border border-dark border-2 align-self-center"
                id="col2">

                <div class="display-5 text-center ">
                    <span style="text-decoration: none; color: inherit;">Admin Console <%= year %></span>
                </div>

                <div class="display-6 fw-bold text-center ">

                </div>
                <div>
                    <% const hasRound1Winner=activeGames.some(game=> game.round === 1 && game.winner); %>
                </div>
                <nav class="navbar navbar-expand-lg navbar-light bg-light">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#adminNavbar">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="adminNavbar">
                        <div class="navbar-nav mx-auto d-flex flex-column flex-lg-row flex-wrap justify-content-center gap-2 mt-3 mt-lg-0">
                            <% if (typeof isNewTournament !=='undefined' && isNewTournament) { %>
                                <button class="btn btn-outline-primary mb-2 text-start" type="button"
                                    id="toggleCreateTournamentFormBtn">Create Bracket</button>
                                <% } %>
                                    <button class="btn btn-outline-secondary mb-2 text-start" type="button"
                                        id="toggleEditTournamentFormBtn">Edit Tournament</button>
                                    <button class="btn btn-outline-secondary mb-2 text-start" type="button"
                                        id="toggleManageEntryFormsBtn">Manage Entry</button>
                                    <button class="btn btn-outline-info mb-2 text-start" type="button"
                                        id="toggleEmailSectionBtn">Bracket Emails</button>
                                    <button class="btn btn-outline-secondary mb-2 text-start" type="button"
                                        id="toggleManageTeamsBtn">Manage
                                        Teams</button>
                                    <a href="/conferences" class="btn btn-outline-secondary mb-2 text-start">Manage
                                        Conferences</a>
                                    <button class="btn btn-outline-secondary mb-2 text-start" type="button"
                                        id="toggleNewGroupFormBtn">New
                                        Group</button>
                                    <form action="/updateTotalPoints" method="post" class="d-inline">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <button class="btn btn-outline-secondary mb-2 text-start" type="submit">Update
                                            Total
                                            Points</button>
                                    </form>

                                    <form id="clearCacheForm" class="d-inline">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <button class="btn btn-outline-danger mb-2 text-start clear-cache-btn"
                                            type="button" id="clearCacheBtn">Clear Cache</button>
                                    </form>
                                    <button class="btn btn-outline-warning mb-2 text-start"
                                        type="button" id="espnPollBtn">Poll ESPN</button>
                                    <button id="pwaRefreshBtn" class="btn btn-outline-secondary mb-2 text-start d-none"
                                        data-act="reloadPage" title="Refresh page">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                            viewBox="0 0 16 16">
                                            <path fill-rule="evenodd"
                                                d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                                            <path
                                                d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                                        </svg>
                                        Refresh
                                    </button>
                                    <script nonce="<%= cspNonce %>">
                                        if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
                                            document.getElementById('pwaRefreshBtn').classList.remove('d-none');
                                        }
                                    </script>
                        </div>
                    </div>
                </nav>

                <div id="espnPollResults" class="container pt-1 pb-1" style="display:none;">
                    <div class="row">
                        <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                            <div id="espnPollResultsInner" class="border rounded p-2" style="font-size: 0.9rem;"></div>
                        </div>
                    </div>
                </div>

                <form action="/changeYear" method="post" id="updateYearForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="container pt-1 pb-1" id="innercontViewYear">
                        <div class="row">
                            <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                <div class="input-group mb-2">
                                    <input type="text" name="year" class="form-control form-control-lg" value="<%= year %>" aria-label="Year">
                                    <div class="input-group-append" >
                                        <button class="button btn btn-outline-secondary ms-2"
                                            type="submit">Update Year</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <form action="/editTournament" method="post" id="editTournamentForm">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="container pt-1 pb-1" id="innercontEditTournament">
                        <div class="row">
                            <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                <div class="input-group mb-2">
                                    <input type="hidden" name="year" value="<%= year %>">
                                    <div class="input-group-append" >
                                        <button class="button btn btn-outline-secondary ms-2" type="submit" <%- hasRound1Winner ? 'disabled' : '' %>>Edit <%= year %> Tournament</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <% if (typeof isNewTournament !=='undefined' && isNewTournament) { %>
                    <form action="/setupNewTourney" method="post" id="createTournamentForm" style="display: none;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="container pt-1 pb-1" id="innercontCreateTournament">
                            <div class="row">
                                <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                    <div class="input-group mb-2">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <div class="input-group-append" >
                                            <button class="button btn btn-outline-primary ms-2" type="submit">Go
                                                to Add New Tourney for <%= year %></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <% } %>

                        <form action="/viewEntry" method="get" id="updateEntryForm">
                            <div class="container pt-1 pb-1" id="innercontEntryID">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="hidden" name="year" value="<%= year %>">
                                            <input type="hidden" name="fromAdmin" value="true">
                                            <input type="text" name="entryId" class="form-control form-control-lg"
                                                placeholder="Enter Entry ID to Edit" aria-label="Entry ID">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    type="submit">Review</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form id="findEntryForm"> <!-- Removed action and method -->
                            <div class="container pt-1 pb-1" id="innercontFindID">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="hidden" name="year" value="<%= year %>">
                                            <input type="text" name="entryName" class="form-control form-control-lg"
                                                placeholder="Lookup Entry" aria-label="Entry name">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    id="findEntryBtn" type="button">Find</button>
                                                <!-- Changed type to button -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <div id="unpaidEntriesContainer" style="display: none;">
                            <div class="container pt-1 pb-1">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="d-grid">
                                            <input type="hidden" id="unpaidYear" value="<%= year %>">
                                            <button class="btn btn-outline-warning btn-lg" type="button" id="unpaidEntriesBtn">
                                                Show Unpaid (Bob)
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="emailSectionContainer" style="display: none;">
                            <div class="container pt-1 pb-1">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="d-grid">
                                            <input type="hidden" id="emailYear" value="<%= year %>">
                                            <button class="btn btn-outline-info btn-lg" type="button" id="loadUnsentEmailsBtn">
                                                Check Unsent Bracket Emails
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <form action="/newEntry" method="post" id="newEntryForm" style="display: none;">
                            <div class="container pt-1 pb-1" id="innercontNewEntry">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="text" name="game" class="form-control form-control-lg"
                                                placeholder="Enter group name for new entry" aria-label="Group name">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    type="submit">Add</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form action="/newGroup" method="post" id="newGroupForm" style="display: none;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="container pt-1 pb-1" id="innercontNewGroup">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="hidden" name="year" value="<%= year %>">
                                            <input type="text" name="groupName" class="form-control form-control-lg"
                                                placeholder="Enter new group name" aria-label="Group name">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    type="submit">Add</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form action="/viewTeam" method="get" id="reviewTeamForm" style="display: none;">
                            <div class="container pt-1 pb-1" id="innercontReviewTeam">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="text" name="teamId" class="form-control form-control-lg"
                                                placeholder="Enter School ID to Review" aria-label="School ID">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    type="submit">Review</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form id="findTeamForm" style="display: none;">
                            <div class="container pt-1 pb-1" id="innercontFindTeam">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <input type="text" name="teamName" class="form-control form-control-lg"
                                                placeholder="Lookup School" aria-label="School name">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    id="findTeamBtn" type="button">Find</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <form action="/addTeamPage" method="get" id="addTeamForm" style="display: none;">
                            <div class="container pt-1 pb-1" id="innercontAddTeam">
                                <div class="row">
                                    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
                                        <div class="input-group mb-2">
                                            <div class="input-group-append" >
                                                <button class="button btn btn-outline-secondary ms-2"
                                                    type="submit" id="addTeamBtn">Add
                                                    New Team</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
            </div>

            <!-- desktop table view  -->
            <div class="mt-2 mb-3 d-none d-lg-block w-100">
                <div class="table-responsive table-scroll w-100" data-mdb-perfect-scrollbar="true"
                                style="position: relative; max-height: 75vh">
                                <table class="table table-striped mb-0 w-100">
                                    <thead>
                                        <tr>
                                            <th colspan="3" class="text-center border-secondary border-2">Game</th>
                                            <th colspan="3" class="text-center border-secondary border-2">Team 1</th>
                                            <th colspan="3" class="text-center border-secondary border-2">Team 2</th>
                                            <th colspan="2" class="text-center border-secondary border-2">Next Game</th>
                                            <th colspan="4" class="text-center border-secondary border-2">Update Info
                                            </th>
                                        </tr>
                                        <tr>
                                            <th class="border-secondary border-2">GameID</th>
                                            <th class="border-secondary border-2">Round</th>
                                            <th class="border-secondary border-2">Region</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">Seed</th>
                                            <th class="border-secondary border-2">Name</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">ID</th>
                                            <th class="border-secondary border-2">Spot</th>
                                            <th class="border-secondary border-2">Winner</th>
                                            <th class="border-secondary border-2">Button</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% activeGames.forEach(group=> { %>
                                            <tr class="game-row" data-game-id="<%= group.gameID %>"
                                                data-round="<%= group.round %>" data-region="<%= group.regionName %>"
                                                data-team1-id="<%= group.team1ID %>"
                                                data-team1-name="<%= group.team1Name %>"
                                                data-team2-id="<%= group.team2ID %>"
                                                data-team2-name="<%= group.team2Name %>"
                                                data-next-game-id="<%= group.nextGameID %>"
                                                data-next-game-spot="<%= group.nextGameSpot %>">
                                                <td>
                                                    <%= group.gameID %>
                                                </td>
                                                <td class="round-display">
                                                    <%= group.round %>
                                                </td>
                                                <td>
                                                    <%= group.regionName %>
                                                </td>
                                                <td>
                                                    <%= group.team1Seed %>
                                                </td>
                                                <td>
                                                    <%= group.team1Name %>
                                                </td>
                                                <td>
                                                    <%= group.team1ID %>
                                                </td>
                                                <td>
                                                    <%= group.team2Seed %>
                                                </td>
                                                <td>
                                                    <%= group.team2Name %>
                                                </td>
                                                <td>
                                                    <%= group.team2ID %>
                                                </td>
                                                <td class="next-game-display">
                                                    <%= group.nextGameID %>
                                                </td>
                                                <td>
                                                    <%= group.nextGameSpot %>
                                                </td>
                                                <td>
                                                    <span class="winner-name-display">
                                                        <%= group.winnerName %>
                                                    </span>
                                                    <select class="form-select winner-select">
                                                        <option value="<%= group.team1ID %>">
                                                            <%= group.team1Name %>
                                                        </option>
                                                        <option value="<%= group.team2ID %>">
                                                            <%= group.team2Name %>
                                                        </option>
                                                    </select>
                                                </td>
                                                <td><button class="btn btn-primary submit-game-result">Submit</button>
                                                    <button class="btn btn-primary undo-game-result">Undo</button>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                </div>
            </div>

            <!-- mobile card view -->
            <div class="d-lg-none mt-3 px-2 pb-4">
                <% activeGames.forEach(group=> { %>
                    <div class="card mb-3 game-row shadow-sm" data-game-id="<%= group.gameID %>"
                        data-round="<%= group.round %>" data-region="<%= group.regionName %>"
                        data-team1-id="<%= group.team1ID %>" data-team1-name="<%= group.team1Name %>"
                        data-team2-id="<%= group.team2ID %>" data-team2-name="<%= group.team2Name %>"
                        data-next-game-id="<%= group.nextGameID %>" data-next-game-spot="<%= group.nextGameSpot %>">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <span class="fw-bold round-display">Round <%= group.round %></span>
                            <span class="badge bg-secondary">
                                <%= group.regionName %>
                            </span>
                            <span class="d-none next-game-display">
                                <%= group.nextGameID %>
                            </span>
                        </div>
                        <div class="card-body py-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="text-center" style="width: 45%;">
                                    <span class="badge bg-light text-dark mb-1 border">
                                        <%= group.team1Seed %>
                                    </span>
                                    <h6 class="mb-0 text-truncate">
                                        <%= group.team1Name %>
                                    </h6>
                                </div>
                                <div class="text-muted small fw-bold">VS</div>
                                <div class="text-center" style="width: 45%;">
                                    <span class="badge bg-light text-dark mb-1 border">
                                        <%= group.team2Seed %>
                                    </span>
                                    <h6 class="mb-0 text-truncate">
                                        <%= group.team2Name %>
                                    </h6>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="mb-2 text-center text-success fw-bold winner-name-display-container">
                                    <span class="winner-name-display">
                                        <%= group.winnerName %>
                                    </span>
                                </div>
                                <select class="form-select mb-2 winner-select">
                                    <option value="<%= group.team1ID %>">
                                        <%= group.team1Name %>
                                    </option>
                                    <option value="<%= group.team2ID %>">
                                        <%= group.team2Name %>
                                    </option>
                                </select>
                                <div class="d-flex gap-2 justify-content-center mt-2">
                                    <button class="btn btn-primary w-100 submit-game-result">Submit Winner</button>
                                    <button class="btn btn-warning w-100 undo-game-result">Undo Winner</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>
        </section>
    </div>
    </div>

    <div>
        <%- include('partials/rulesModal') %> <%- include('partials/scripts') %>
    </div>

    <!-- Find Entry Modal -->
    <div class="modal fade" id="findEntryModal" tabindex="-1" aria-labelledby="findEntryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="findEntryModalLabel">Entry Search Results</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="findEntryModalBody">
                    <!-- Results will be injected here -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Unpaid Entries Modal -->
    <div class="modal fade" id="unpaidEntriesModal" tabindex="-1" aria-labelledby="unpaidEntriesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="unpaidEntriesModalLabel">Unpaid Entries — Bob</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="unpaidEntriesModalBody">
                    <!-- Results will be injected here -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bracket Emails Modal -->
    <div class="modal fade" id="bracketEmailsModal" tabindex="-1" aria-labelledby="bracketEmailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="bracketEmailsModalLabel">Bracket Emails</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="bracketEmailsModalBody">
                    <!-- Results will be injected here -->
                </div>
                <div class="modal-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <button type="button" class="btn btn-outline-secondary me-2" id="copyEmailDataBtn" style="display:none;">
                            Copy Entry Data
                        </button>
                        <button type="button" class="btn btn-success" id="markAllSentBtn" style="display:none;">
                            Mark All as Sent
                        </button>
                    </div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Find Team Modal -->
    <div class="modal fade" id="findTeamModal" tabindex="-1" aria-labelledby="findTeamModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="findTeamModalLabel">School Search Results</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="findTeamModalBody">
                    <!-- Results will be injected here -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const toggleEditTournamentFormBtn = document.getElementById('toggleEditTournamentFormBtn'); // Edit Tournament
            const toggleManageEntryFormsBtn = document.getElementById('toggleManageEntryFormsBtn'); // Manage Entry
            const toggleManageTeamsBtn = document.getElementById('toggleManageTeamsBtn'); // Manage Teams
            const toggleNewGroupFormBtn = document.getElementById('toggleNewGroupFormBtn'); // New Group
            const toggleCreateTournamentFormBtn = document.getElementById('toggleCreateTournamentFormBtn'); // Create Bracket
            const updateYearForm = document.getElementById('updateYearForm'); // Update Year Form
            const editTournamentForm = document.getElementById('editTournamentForm'); // Edit Tournament Form
            const createTournamentForm = document.getElementById('createTournamentForm'); // Create Tournament Form
            const updateEntryForm = document.getElementById('updateEntryForm'); // Update Entry Form
            const findEntryForm = document.getElementById('findEntryForm'); // Find Entry Form
            const newEntryForm = document.getElementById('newEntryForm'); // New Entry Form
