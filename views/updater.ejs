            const manageTeamsForms = [reviewTeamForm, findTeamForm, addTeamForm];

            // Helper to hide a form or an array of forms
            const hideFormGroup = (group) => {
                if (Array.isArray(group)) {
                    group.forEach(form => { if (form) form.style.display = 'none'; });
                } else if (group) {
                    group.style.display = 'none';
                }
            };

            // Initially hide all toggleable forms
            hideFormGroup(editTournamentForms);
            hideFormGroup(manageEntryForms);
            hideFormGroup(manageTeamsForms);
            hideFormGroup(newGroupForm);

            // Generic function to create a toggle listener for mutually exclusive sections
            const createToggleListener = (button, sectionToToggle, otherSections) => {
                if (!button || (Array.isArray(sectionToToggle) ? !sectionToToggle.every(f => f) : !sectionToToggle)) {
                    return;
                }
                button.addEventListener('click', () => {
                    // Check the current visibility of the section we want to toggle
                    const isHidden = Array.isArray(sectionToToggle)
                        ? sectionToToggle[0].style.display === 'none'
                        : sectionToToggle.style.display === 'none';

                    // Hide all other sections first
                    otherSections.forEach(hideFormGroup);

                    // Then, toggle the target section
                    const newDisplay = isHidden ? 'block' : 'none';
                    if (Array.isArray(sectionToToggle)) {
                        sectionToToggle.forEach(form => form.style.display = newDisplay);
                    } else {
                        sectionToToggle.style.display = newDisplay;
                    }
                });
            };

            // Setup listeners for each button to make them mutually exclusive
            createToggleListener(toggleEditTournamentFormBtn, editTournamentForms, [manageEntryForms, manageTeamsForms, newGroupForm, createTournamentForm, emailSectionContainer]);
