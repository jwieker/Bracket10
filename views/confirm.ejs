<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
</head>


<body>
    <div class="container- pt-3" id="cont">
        <div class="row" id="row1">
            <!-- <div class="col" id="col1"></div> -->

            <div class="col-10 offset-1 col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 col-xl-6 offset-xl-3 pl-1 pr-1  border border-dark border-2 align-self-center"
                id="col2">
                <div class="mb-2 fs-4 pt-3 pb-3 fw-bold text-center">
                    Your submission has been added!
                    <br>
                    Come back once the games start to see the scores
                </div>
                <div class="mb-2 fs-5 text-center">
                    Take a screenshot for your records. If you have any questions reach out to your group admin.
                </div>

                <% if (typeof isPaymentCollectorGroup !=='undefined' && isPaymentCollectorGroup) { %>
                    <div class="mt-3 mb-3 p-3 border border-primary rounded bg-light text-center">
                        <h4 class="text-primary fw-bold">Payment Info <% if (paymentCollectorGroup) { %>for <%= paymentCollectorGroup %><% } %></h4>
                        <p class="fs-5">
                            To pay your entry fee digitally, I'm collecting through:
                        </p>
                        <div class="d-flex justify-content-center align-items-center gap-4 mb-3 flex-wrap">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/4/4c/Zelle_logo.svg" alt="Zelle"
                                style="height: 55px;">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/b/b5/PayPal.svg" alt="PayPal"
                                style="height: 35px;">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/45/Venmo_Logo.svg/1920px-Venmo_Logo.svg.png?20211021224844"
                                alt="Venmo" style="height: 25px;">
                        </div>
                        <% if (typeof paymentCollector !== 'undefined' && (paymentCollector.collectorName || paymentCollector.collectorEmail || paymentCollector.collectorPhone)) { %>
                        <div class="d-flex justify-content-center align-items-center gap-4 mt-4 flex-wrap">
                            <% if (paymentCollector.collectorName) { %>
                            <div class="d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                <span class="fs-6"><%= paymentCollector.collectorName %></span>
                            </div>
                            <% } %>
                            <% if (paymentCollector.collectorEmail) { %>
                            <div class="d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z">
                                    </path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <span class="fs-6"><%= paymentCollector.collectorEmail %></span>
                            </div>
                            <% } %>
                            <% if (paymentCollector.collectorPhone) { %>
                            <div class="d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.21-2.21a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                    </path>
                                </svg>
                                <span class="fs-6"><%= paymentCollector.collectorPhone %></span>
                            </div>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                    <% } %>
            </div>

            <div class="col-10 offset-1 col-sm-10 mt-2 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3 col-xl-6 offset-xl-3 pl-1 pr-1  border border-dark border-2 align-self-center"
                id="col2">
                <div class="mb-2 fs-5 pt-3 fw-bold text-left">
                    Entry info:<br>
                </div>
                <div class="pb-3 fs-5 text-left">
                    Name: <%= name %><br>
                        Team Name: <%= team %><br>
                            Group Name: <%= groupName %><br>
                                <b>Picks:</b> <br>
                                <% for (let i=0; i < picksNames.length; i++) { %>
                                    <%= i + 1 %>. <%= picksNames[i] %><br>
                                            <% } %>


                </div>

            </div>
            <!-- <div class="col" id="col3"></div> -->
        </div>
    </div>

    <div>
        <%- include('partials/rulesModal') %>
            <%- include('partials/scripts') %>
    </div>



</body>
<footer>

</footer>


</html>