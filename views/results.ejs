<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
        <!-- sorting -->
        <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/tablesort@5.3.0/dist/tablesort.min.js"
            integrity="sha384-vhcBfNt762rNlbnxZsIJQSPWX7b+8NzToPmcW6J5cJzXSnOjZKS2LQ/O2uqLlHcX" crossorigin="anonymous"></script>
        <!-- <script nonce="<%= cspNonce %>" src='tablesort.number.js'></script> -->
        <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/tablesort@5.3.0/dist/sorts/tablesort.number.min.js"
            integrity="sha384-yt4K6HL9dLK27YW0wB3TsVyPTrtPn6Nk/l6dsN6bA7UPj+dnl1qMC+Ia2udCYEz1" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="/table-styles.css">
</head>

<body>
    <!-- Popper.js is included in Bootstrap bundle, no need to load separately -->
    <!-- <div class="container mt-4 mb-5" style="max-width: 1400px; padding: 0 1rem;"> -->

    <%# Signed-in participant's own entry IDs (matched server-side; no emails here). %>
    <% const __mineSet = new Set((((typeof myEntryIds !== 'undefined') && myEntryIds) || []).map(String));
       const isMine = (id) => __mineSet.has(String(id)); %>

    <div class="col-12 col-xxl-10 mx-auto mt-2" style="max-width: 1300px;">
        <div class="card-table-container">
            <div class="card-table-header">
                <h3 class="card-table-title">Results for group: <%= name %>
                </h3>

                <div class="d-flex flex-wrap gap-3 align-items-center mt-3 mt-md-0">
                    <form action="/getFullGrid" method="post" class="m-0">
                        <input type="hidden" name="gameName" value="<%= name %>" />
                        <input type="hidden" name="gameYear" value="<%= requestedYear %>" />
                        <button class="btn btn-sm text-white px-3 py-2 btn-primary"
                            type="submit">See full grid of picks</button>
                    </form>

                    <button id="pwaRefreshBtn" class="btn btn-sm btn-outline-secondary d-none px-3 py-2 rounded-3"
                         data-act="reloadPage" title="Refresh page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            viewBox="0 0 16 16">
                            <path fill-rule="evenodd"
                                d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                            <path
                                d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                        </svg>
                    </button>
                    <!-- Script relocated next to button for simplicity -->
                    <script nonce="<%= cspNonce %>">
                        if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
                            document.getElementById('pwaRefreshBtn').classList.remove('d-none');
                        }
                    </script>

                    <form method="POST" action="/gameView" class="m-0 d-flex align-items-center gap-2">
                        <input type="hidden" name="game" value="<%= name %>">
                        <% if (availableYears && availableYears.length> 1) { %>
                            <a href="#" id="toggleYearSelect" class="text-decoration-none year-select-link">Previous Years</a>
                            <select name="year" id="yearSelect"
                                class="form-select form-select-sm border border-secondary year-select-custom">
                                <% availableYears.forEach(function(yearOption) { %>
                                    <option value="<%= yearOption %>" <%=yearOption==currentYear ? 'selected' : '' %>>
                                        <%= yearOption %>
                                    </option>
                                    <% }); %>
                            </select>
                            <% } %>
                    </form>
                </div>
            </div>

            <!-- ══ SEARCH BAR ══ -->
            <div class="results-search-bar">
                <div class="results-search-wrap">
                    <svg class="results-search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
                    </svg>
                    <input type="search"
                           id="resultsSearch"
                           class="results-search-input"
                           placeholder="Search by name or team…"
                           autocomplete="off">
                    <span class="results-search-count" id="resultsCount"></span>
                </div>
            </div>

            <div class="results-table-wrapper">
                <% 
                    const rank1Group = groupData.find(g => g.rank === 1);
                    const isTourneyOver = rank1Group && rank1Group.totalPoints === rank1Group.possPoints;
                %>
            <div class="table-responsive" data-mdb-perfect-scrollbar="true">
                <table class="table mb-0 table-hover table-view-collapse custom-card-table" id="groupTable">
                    <thead>
                        <tr>
                            <th class="col-expand-toggle"></th>
                            <th>Entry</th>
                            <th data-sort-method="number" class="tbl-rank-sort-cell">Rank</th>
                            <th data-sort-method="number" class="tbl-pts-cell">Points</th>
                            <th class="col-collapsible tbl-teams-cell" data-sort-method="number">Teams Left <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" data-bs-toggle="tooltip" data-bs-placement="top" title="'Advanced' shows how many of your remaining teams have won a game in the current round." style="cursor:help;vertical-align:middle;opacity:0.5"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/></svg></th>
                            <th class="col-collapsible col-hide-sm tbl-num-cell" data-sort-method="number">Max Possible</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 1 ×2</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 2 ×3</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 3 ×5</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 4 ×9</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 5 ×17</th>
                            <th class="col-collapsible col-hide-md tbl-rnd-cell" data-sort-method="number">Rd 6 ×33</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% groupData.forEach(group=> { %>
                            <tr class="<%= isMine(group.id) ? 'my-entry' : '' %>" data-group-id="<%= group.id %>" data-search="<%= (group.person + ' ' + group.teamName).toLowerCase() %>">
                                <td class="col-expand-toggle"></td>
                                <td class="text-start text-md-nowrap">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="tbl-rank-badge"><%= group.rank %></span>
                                        <div class="tbl-entry-names">
                                            <button type="button" class="btn btn-link p-0 tbl-person-btn"
                                                data-bs-toggle="modal" data-bs-target="#picksModal<%= group.id %>">
                                                <% if (group.rank===1 && isTourneyOver) { %>🏆 <% } %><%= group.person %>
                                            </button><span class="tbl-sep"> · </span><span class="tbl-team-name"><%= group.teamName %></span><% if (isMine(group.id)) { %><span class="you-tag" title="This entry is yours">You</span><% } %>
                                        </div>
                                    </div>
                                    <div class="modal fade" id="picksModal<%= group.id %>" tabindex="-1"
                                        aria-labelledby="picksModalLabel<%= group.id %>" aria-hidden="true">
                                        <div class="modal-dialog modal-xl">
                                            <div class="modal-content border border-dark border-2">
                                                <div class="modal-header bracket-header text-white">
                                                    <div class="flex-grow-1">
                                                        <h5 class="modal-title h4 mb-0"
                                                            id="picksModalLabel<%= group.id %>">
                                                            <%= group.person %> - <%= group.teamName %>
                                                        </h5>
                                                        <div class="d-flex gap-3 mt-1 text-white" style="font-size: 1rem;">
                                                            <span>Teams Remaining: <%= group.teamsRemaining || 0 %></span>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex gap-2 me-2">
                                                        <button type="button" class="btn btn-outline-light btn-sm modal-nav-prev" aria-label="Previous entry">&#8592;</button>
                                                        <button type="button" class="btn btn-outline-light btn-sm modal-nav-next" aria-label="Next entry">&#8594;</button>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>
                                                <!-- New row for side-by-side layout on large screens -->

                                                <div class="row">
                                                    <!-- Bracket Column -->
                                                    <div class="col-12 col-lg-5">
                                                        <div class="row m-1">
                                                            <div class="biggertext col-9">
                                                                <strong>
                                                                    Points: <%= group.totalPoints || 0 %>
                                                                </strong>
                                                            </div>
                                                            <div class="biggertext col-9">
                                                                <strong>

                                                                    Max Possible Points:
                                                                    <%= group.possPoints || 0 %>
                                                                </strong>
                                                            </div>
                                                        </div>


                                                        <div class="picks-card-list mx-lg-2 mt-2">
                                                            <% group.pickNames.forEach(pick=> {
                                                                const isElim = pick.gameStatus && pick.gameStatus.length > 0 && pick.gameStatus[pick.gameStatus.length - 1] === 'L';
                                                                const accentColor = pick.primaryColor ? '#' + pick.primaryColor : '#adb5bd';
                                                            %>
                                                            <div class="pick-card-row d-flex align-items-center gap-2 py-2 px-2"
                                                                 data-accent="<%= accentColor %>"
                                                                 data-elim="<%= isElim ? '1' : '0' %>">
                                                                <!-- Logo -->
                                                                <div class="pick-logo-box flex-shrink-0" data-border-color="<%= accentColor %>">
                                                                    <% if (pick.logoUrl) { %>
                                                                        <img src="<%= pick.logoUrl %>" alt="<%= pick.nameNick %>" style="width:100%;height:100%;object-fit:contain;" loading="lazy">
                                                                    <% } else { %>
                                                                        <span class="pick-logo-fallback"><%= (pick.nameNick || '?').substring(0,2).toUpperCase() %></span>
                                                                    <% } %>
                                                                </div>
                                                                <!-- Seed + Name + Region -->
                                                                <div class="flex-grow-1" style="min-width:0;">
                                                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                                                        <span class="badge-ds" style="font-size:0.6rem;font-weight:600;"><%= pick.seed %></span>
                                                                        <span class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= pick.nameNick || pick.name %></span>
                                                                    </div>
                                                                    <div class="text-muted" style="font-size:0.7rem;"><%= pick.regionName %></div>
                                                                </div>
                                                                <!-- W/L chips -->
                                                                <div class="pick-wl-chips">
                                                                    <% if (pick.gameStatus && pick.gameStatus.length > 0) {
                                                                        pick.gameStatus.forEach(result => { %>
                                                                        <span class="wl-chip <%= result === 'W' ? 'win' : 'loss' %>"><%= result %></span>
                                                                    <% }); } %>
                                                                </div>
                                                                <!-- Points -->
                                                                <div class="text-end flex-shrink-0" style="min-width:34px;">
                                                                    <div class="pick-pts fw-bold" data-accent="<%= accentColor %>" data-elim="<%= isElim ? '1' : '0' %>" style="font-size:0.95rem;line-height:1;"><%= pick.pickPoints || 0 %></div>
                                                                    <div class="text-muted" style="font-size:0.65rem;">pts</div>
                                                                </div>
                                                            </div>
                                                            <% }); %>
                                                        </div>

                                                        <% const entryConfStats={}; group.pickNames.forEach(pick=> {
                                                            const confName = pick.conferenceName;
                                                            if (confName) {
                                                            if (!entryConfStats[confName]) entryConfStats[confName] = 0;
                                                            entryConfStats[confName]++;
                                                            }
                                                            });
                                                            const sortedConfStats =
                                                            Object.entries(entryConfStats).sort((a,b) => b[1] - a[1]);
                                                            %>
                                                            <% if (sortedConfStats.length> 0) { %>
                                                                <div class="d-flex flex-wrap gap-1 mt-2 mb-1 mx-lg-2 px-2">
                                                                    <% sortedConfStats.forEach(([confName, count])=> { %>
                                                                        <span class="badge bg-primary" style="font-size:0.75em;"><%= count %> <%= confName %></span>
                                                                    <% }); %>
                                                                </div>
                                                            <% } %>
                                                    </div>
                                                    <div class="col-12 col-lg-7">
                                                        <div class="row m-lg-2" id="bracketRow">
                                                            <div class="col-12">
                                                                <%- include('partials/bracket.ejs') %>

                                                                    <div class="legend row justify-content-center">
                                                                        <div class="legend-item col-2 picked">
                                                                            <span>Upcoming</span>
                                                                        </div>
                                                                        <div
                                                                            class="legend-item col-2 picked-win text-center">
                                                                            <span>Win</span>
                                                                        </div>
                                                                        <div class="legend-item col-2 picked-loss">
                                                                            <span>Loss</span>
                                                                        </div>
                                                                    </div>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <!-- Picks Table Column -->

                                                </div>

                                            </div>
                                        </div>
                                    </div>
            </td>
            <!-- <td>
                                                        <ul>
                                                            <% group.pickNames.forEach(pick=> { %>
                                                                <li>
                                                                    <%= pick.seed %> - <%= pick.nameNick %>
                                                                            <%= pick.mascot %>
                                                                </li>
                                                                <% }); %>
                                                        </ul>
                                                    </td> -->
            <td class="tbl-rank-sort-cell"><%= group.rank %></td>
            <td class="tbl-pts-cell">
                <span class="tbl-pts-val"><%= group.totalPoints || 0 %></span><span class="tbl-pts-lbl"> pts</span>
            </td>
            <td data-label="Teams Remaining" class="col-collapsible tbl-teams-cell" data-sort="<%= group.teamsRemaining || 0 %>">
                <% if ((group.teamsRemaining || 0) > 0) { %><span class="tbl-teams-badge"><%= group.teamsRemaining %><% if (group.teamsAdvanced > 0) { %> (<%= group.teamsAdvanced %> adv)<% } %></span><% } else { %><span class="tbl-teams-badge tbl-teams-zero">0</span><% } %>
            </td>
            <td data-label="Max Possible Points" class="col-collapsible col-hide-sm tbl-num-cell">
                <%= group.possPoints || 0 %>
            </td>
            <% const rds = [0,1,2,3,4,5].map(i => (group.picksProgress && group.picksProgress[i] ? group.picksProgress[i][3] : 0) || 0); %>
            <td data-label="Rd 1 ×2" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[0]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[0] %></span></td>
            <td data-label="Rd 2 ×3" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[1]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[1] %></span></td>
            <td data-label="Rd 3 ×5" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[2]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[2] %></span></td>
            <td data-label="Rd 4 ×9" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[3]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[3] %></span></td>
            <td data-label="Rd 5 ×17" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[4]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[4] %></span></td>
            <td data-label="Rd 6 ×33" class="col-collapsible col-hide-md tbl-rnd-cell"><span class="<%= rds[5]===0 ? 'tbl-rnd-zero' : '' %>"><%= rds[5] %></span></td>

            </tr>
            <% }); %>
                </tbody>
                </table>
            </div> <!-- closing table-responsive div -->
            </div> <!-- closing results-table-wrapper div -->

            <!-- ══ MOBILE CARD LIST (hidden ≥769px via CSS) ══ -->
            <div class="mobile-card-list">
                <% groupData.forEach(function(group) {
                    const rankClass = '';
                    const rankLabel = group.rank;
                    const hasTeams = (group.teamsRemaining || 0) > 0;
                    const rd = [0,1,2,3,4,5].map(i => (group.picksProgress && group.picksProgress[i] ? group.picksProgress[i][3] : 0) || 0);
                    const rdLabels = ['Rd 1·2pts','Rd 2·3pts','Rd 3·5pts','Rd 4·9pts','Rd 5·17pts','Rd 6·33pts'];
                %>
                <div class="mob-entry-card<%= isMine(group.id) ? ' my-entry' : '' %>" id="mob-card-<%= group.id %>" data-search="<%= (group.person + ' ' + group.teamName).toLowerCase() %>">

                    <!-- Visible Row: Rank, Content, and Points -->
                    <div class="mob-card-visible-row">
                        <!-- Rank -->
                        <div class="mob-rank-col"
                             data-bs-toggle="modal"
                             data-bs-target="#picksModal<%= group.id %>"
                             style="cursor:pointer; -webkit-tap-highlight-color:transparent;">
                            <div class="mob-rank-badge <%= rankClass %>"><%= rankLabel %></div>
                        </div>

                        <!-- Content: Name & Stats -->
                        <div class="mob-content-col"
                             data-bs-toggle="modal"
                             data-bs-target="#picksModal<%= group.id %>"
                             style="cursor:pointer; -webkit-tap-highlight-color:transparent;">
                            <div class="mob-name-block">
                                <span class="mob-person-name" style="pointer-events: none;">
                                    <% if (group.rank === 1 && isTourneyOver) { %>🏆 <% } %><%= group.person %><span class="mob-sep"> · </span><span class="mob-team-inline"><%= group.teamName %></span><% if (isMine(group.id)) { %><span class="you-tag" title="This entry is yours">You</span><% } %>
                                </span>
                            </div>
                            <div class="mob-stat-strip">
                                <span class="mob-stat-chip">Max <strong><%= group.possPoints || 0 %></strong></span>
                                <% if (hasTeams) { %>
                                <span class="mob-alive-badge"><%= group.teamsRemaining || 0 %> team<%= group.teamsRemaining !== 1 ? 's' : '' %><% if (group.teamsAdvanced > 0) { %> (<%= group.teamsAdvanced %> adv)<% } %></span>
                                <% } else { %>
                                <span class="mob-elim-badge">Eliminated</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Points & Toggle -->
                        <div class="mob-pts-col"
                             data-bs-toggle="collapse"
                             href="#mob-round-<%= group.id %>"
                             role="button"
                             aria-expanded="false"
                             aria-controls="mob-round-<%= group.id %>"
                             data-act="toggleMobCard" data-act-arg="<%= group.id %>"
                             style="cursor: pointer; -webkit-tap-highlight-color: transparent;">
                            <div class="mob-pts-row">
                                <span class="mob-pts-total"><%= group.totalPoints || 0 %></span>
                                <span class="mob-chevron">▼</span>
                            </div>
                            <span class="mob-pts-label">pts</span>
                        </div>
                    </div>

                    <!-- Round breakdown: tap card header to reveal -->
                    <div class="collapse" id="mob-round-<%= group.id %>">
                        <div class="mob-round-detail" style="display: block;">
                            <div class="mob-round-grid">
                                <% for (let i = 0; i < 6; i++) { %>
                                <div class="mob-round-item">
                                    <span class="mob-round-pts <%= rd[i] === 0 ? 'zero' : '' %>"><%= rd[i] %></span>
                                    <span class="mob-round-lbl"><%= rdLabels[i] %></span>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                </div>
                <% }); %>
            </div>
            <!-- ══ END MOBILE CARD LIST ══ -->

        </div> <!-- closing card-table-container div -->
    </div> <!-- closing container div -->

    <script nonce="<%= cspNonce %>">
        function toggleMobCard(id) {
            const card = document.getElementById('mob-card-' + id);
            if (card) card.classList.toggle('expanded');
        }

        // Shared search — filters desktop table rows AND mobile cards simultaneously
        (function () {
            const searchInput = document.getElementById('resultsSearch');
            const countEl     = document.getElementById('resultsCount');

            function filterResults() {
                const q = searchInput ? searchInput.value.toLowerCase().trim() : '';

                const tableRows   = document.querySelectorAll('#groupTable tbody tr[data-search]');
                const mobileCards = document.querySelectorAll('.mob-entry-card[data-search]');

                let visible = 0;

                tableRows.forEach(function (row) {
                    const match = !q || row.dataset.search.includes(q);
                    row.style.display = match ? '' : 'none';
                    // Keep any adjacent details-row in sync
                    const next = row.nextElementSibling;
                    if (next && next.classList.contains('details-row')) {
                        next.style.display = match ? '' : 'none';
                    }
                    if (match) visible++;
                });

                mobileCards.forEach(function (card) {
                    const match = !q || card.dataset.search.includes(q);
                    card.style.display = match ? '' : 'none';
                });

                if (countEl) {
                    const total = tableRows.length;
                    countEl.textContent = q
                        ? (visible + ' of ' + total + ' ' + (total === 1 ? 'entry' : 'entries'))
                        : (total + ' ' + (total === 1 ? 'entry' : 'entries'));
                }
            }

            // Wire up input — no inline handlers needed
            if (searchInput) {
                searchInput.addEventListener('input', filterResults);
                // Clear button (×) resets the filter too
                searchInput.addEventListener('search', filterResults);
            }

            // Initialise count immediately (script runs after DOM is rendered)
            filterResults();
        }());
    </script>

    <div>
        <%- include('partials/rulesModal') %> <%- include('partials/scripts') %>
    </div>

    <script nonce="<%= cspNonce %>" type="application/json" id="gameDataJson"><%- safeJson(gameData || {}) %></script>
    <script nonce="<%= cspNonce %>" type="application/json" id="regionDataJson"><%- safeJson(regions || []) %></script>
    <script nonce="<%= cspNonce %>" type="application/json" id="teamDataJson"><%- safeJson(teamData || []) %></script>
    <script nonce="<%= cspNonce %>" type="application/json" id="groupDataJson"><%- safeJson(groupData || []) %></script>

    <script nonce="<%= cspNonce %>">
        function esc(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        const yearSelectElement = document.getElementById('yearSelect');
        if (yearSelectElement) {
            yearSelectElement.addEventListener('change', function () {
                this.form.submit();
            });
        }

        const toggleYearSelectLink = document.getElementById('toggleYearSelect');
        if (toggleYearSelectLink && yearSelectElement) {
            toggleYearSelectLink.addEventListener('click', function (event) {
                event.preventDefault(); // Prevent default link behavior
                const isHidden = getComputedStyle(yearSelectElement).display === 'none';
                yearSelectElement.style.display = isHidden ? 'inline-block' : 'none'; // Toggle display
            });
        }

        const gameData = JSON.parse(document.getElementById('gameDataJson').textContent);
        const regionData = JSON.parse(document.getElementById('regionDataJson').textContent);
        const teamData = JSON.parse(document.getElementById('teamDataJson').textContent);
        // console.log("Game Data: " + JSON.stringify(gameData));
        // console.log("Region Data: " + JSON.stringify(regionData));



        // --- Debounce function ---
        function debounce(func, wait, immediate) {
            var timeout;
            return function () {
                var context = this, args = arguments;
                var later = function () {
                    timeout = null;
                    if (!immediate) func.apply(context, args);
                };
                var callNow = immediate && !timeout;
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
                if (callNow) func.apply(context, args);
            };
        };

