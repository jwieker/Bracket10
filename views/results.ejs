                }

                // --- Add event listener to draw overlays when modal is SHOWN ---
                modal.addEventListener('shown.bs.modal', event => {
                    // console.log(`Modal shown: ${modal.id}`);
                    // Extract group ID from the modal's ID (e.g., "picksModal123" -> "123")
                    const groupId = modal.id.replace('picksModal', '');
                    if (!groupId) {
                        console.error(`Could not extract group ID from modal ID: ${modal.id}`);
                        return;
                    }


                    adjustR3MatchupMargins(modal);
                    adjustTeamNameFontSize(modal);

                    modal.querySelector('#regionTopLeft').textContent = regionData[0];
                    modal.querySelector('#regionBottomLeft').textContent = regionData[1];
                    modal.querySelector('#regionTopRight').textContent = regionData[2];
                    modal.querySelector('#regionBottomRight').textContent = regionData[3];
                    // Find the corresponding group data using the extracted ID
                    // Use == for comparison in case groupId is a string and currentGroup.id is a number

                    const currentGroup = groupData.find(g => g.id == groupId);


                    if (currentGroup && currentGroup.pickNames) {
                        // console.log(`Found group data for ID: ${groupId}. Drawing overlays.`);
                        createTeamFills(modal, groupId, currentGroup.pickNames);

                        // --- New Tooltip Grouping Logic ---
                        const tooltipElements = Array.from(modal.querySelectorAll('[data-bs-toggle="tooltip"]'));
                        const tooltipsGroupedByTitle = {};

                        // Initialize all tooltips with 'manual' trigger and group them by their bs-title
                        tooltipElements.forEach(el => {
                            const title = el.dataset.bsTitle;
                            if (!title) return; // Skip if no title, though createTeamFills should set it

                            // Initialize the tooltip instance for this element
                            new bootstrap.Tooltip(el, {
                                trigger: 'manual', // We will control show/hide
                                container: 'body', // Append tooltip to the body
                                boundary: 'window'  // Keep tooltip within window bounds
                            });

                            if (!tooltipsGroupedByTitle[title]) {
                                tooltipsGroupedByTitle[title] = [];
                            }
                            tooltipsGroupedByTitle[title].push(el);
                        });

                        // Add event listeners to each element to control its group's tooltips
                        tooltipElements.forEach(triggerEl => {
                            const title = triggerEl.dataset.bsTitle;
                            if (!title || !tooltipsGroupedByTitle[title]) return;

                            triggerEl.addEventListener('mouseenter', () => {
                                tooltipsGroupedByTitle[title].forEach(groupMemberEl => {
                                    const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                    if (instance) instance.show();
                                });
                            });

                            triggerEl.addEventListener('mouseleave', () => {
                                tooltipsGroupedByTitle[title].forEach(groupMemberEl => {
                                    const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                    if (instance) instance.hide();
                                });
                            });
                        });
                        // --- End of New Tooltip Grouping Logic ---

                        // --- New: Tooltip control from Picks Table click ---
                        let activeTableClickedTeamGroup = null; // Tracks the currently "active" group from table click

                        const picksTableRows = modal.querySelectorAll('#picksTable tbody tr[data-team-name]');
                        picksTableRows.forEach(row => {
                            const teamName = row.dataset.teamName;
                            const currentTeamBracketElements = tooltipsGroupedByTitle[teamName];

                            if (teamName && currentTeamBracketElements && currentTeamBracketElements.length > 0) {
                                row.style.cursor = 'pointer'; // Indicate clickable

                                row.addEventListener('mouseenter', () => {
                                    currentTeamBracketElements.forEach(groupMemberEl => {
                                        const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                        if (instance) instance.show();
                                    });
                                });

                                row.addEventListener('mouseleave', () => {
                                    // Only hide if this group is not the actively clicked/pinned one
                                    if (activeTableClickedTeamGroup !== currentTeamBracketElements) {
                                        currentTeamBracketElements.forEach(groupMemberEl => {
                                            const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                            if (instance) instance.hide();
                                        });
                                    }
                                });

                                row.addEventListener('click', () => {
                                    // If a different group was "pinned" by a click, unpin it and hide its tooltips
                                    if (activeTableClickedTeamGroup && activeTableClickedTeamGroup !== currentTeamBracketElements) {
                                        activeTableClickedTeamGroup.forEach(groupMemberEl => {
                                            const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                            if (instance) instance.hide();
                                        });
                                        activeTableClickedTeamGroup = null; // Clear the old pinned group
                                    }

                                    // Toggle the "pinned" state for the current group
                                    if (activeTableClickedTeamGroup === currentTeamBracketElements) {
                                        // This group was already pinned, so unpin it and hide its tooltips
                                        currentTeamBracketElements.forEach(groupMemberEl => {
                                            const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                            if (instance) instance.hide();
                                        });
                                        activeTableClickedTeamGroup = null;
                                    } else {
                                        // Pin this group: show its tooltips and set it as active
                                        currentTeamBracketElements.forEach(groupMemberEl => {
                                            const instance = bootstrap.Tooltip.getInstance(groupMemberEl);
                                            if (instance) instance.show();
                                        });
                                        activeTableClickedTeamGroup = currentTeamBracketElements;
                                    }
                                });
                            }
                        });
                        // --- End of New Tooltip control from Picks Table click ---
                    } else {
                        console.error(`Could not find group data or pickNames for group ID: ${groupId}`);
                    }
                });

                modal.addEventListener('hidden.bs.modal', () => {
                    // Clean up any tooltips that might be lingering when the modal is closed
                    const tooltipsToHide = modal.querySelectorAll('[data-bs-toggle="tooltip"]');
                    tooltipsToHide.forEach(el => {
                        const instance = bootstrap.Tooltip.getInstance(el);
                        if (instance) {
                            instance.hide();
                        }
                    });
                    // activeTableClickedTeamGroup is scoped to the 'shown.bs.modal' event, so it's naturally reset.

                    // After ID-swapping navigation, Bootstrap's internal state can get out of sync
                    // and leave a stuck backdrop or modal-open class on body. Force cleanup here.
                    if (!document.querySelector('.modal.show')) {
                        document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.removeProperty('overflow');
                        document.body.style.removeProperty('padding-right');
                    }
                });
            });

            // Left/right arrow key navigation between entry modals
            // Build in sorted display order by reading from the already-sorted table rows
            const entryModalIds = groupTable
                ? Array.from(groupTable.tBodies[0].rows).map(row => {
                    const btn = row.querySelector('[data-bs-target^="#picksModal"]');
                    return btn ? btn.getAttribute('data-bs-target').slice(1) : null;
                }).filter(Boolean)
                : groupData.map(g => 'picksModal' + g.id);
            let navigating = false;

            function navigateModal(direction) {
                if (navigating) return;

                const currentModal = document.querySelector('.modal.show');
                if (!currentModal) return;

                const currentIndex = entryModalIds.indexOf(currentModal.id);
                if (currentIndex === -1) return;

                const nextIndex = direction === 'next'
                    ? (currentIndex + 1) % entryModalIds.length
                    : (currentIndex - 1 + entryModalIds.length) % entryModalIds.length;

                const nextModalEl = document.getElementById(entryModalIds[nextIndex]);
                if (!nextModalEl) return;

                navigating = true;

                const currentContent = currentModal.querySelector('.modal-content');
                const nextContent = nextModalEl.querySelector('.modal-content');

                // Fade out just the content box — backdrop stays perfectly still
                currentContent.style.transition = 'opacity 0.12s ease';
                currentContent.style.opacity = '0';

                setTimeout(() => {
                    // Swap the .modal-content elements between the two modal wrappers
                    const placeholder = document.createComment('nav-swap');
                    nextContent.before(placeholder);
                    currentModal.querySelector('.modal-dialog').replaceChild(nextContent, currentContent);
                    placeholder.replaceWith(currentContent);

                    // Swap IDs so all existing event listeners keep working
                    const prevId = currentModal.id;
                    currentModal.id = nextModalEl.id;
                    nextModalEl.id = prevId;

                    // Fire the shown.bs.modal logic (fills bracket, sets up tooltips, etc.)
                    currentModal.dispatchEvent(new Event('shown.bs.modal'));

                    // Fade in the new content
                    nextContent.style.transition = '';
                    nextContent.style.opacity = '0';
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            nextContent.style.transition = 'opacity 0.12s ease';
                            nextContent.style.opacity = '1';
                            setTimeout(() => { navigating = false; }, 120);
                        });
                    });
                }, 120);
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowLeft') navigateModal('prev');
                else if (e.key === 'ArrowRight') navigateModal('next');
            });

            document.addEventListener('click', function (e) {
                if (e.target.closest('.modal-nav-prev')) navigateModal('prev');
                else if (e.target.closest('.modal-nav-next')) navigateModal('next');
            });
        });



        // Function to adjust R3 matchup margins based on parent .round.r3 height
        function adjustR3MatchupMargins(contextElement) { // Added contextElement parameter
            // If no context is provided (e.g. initial call or global resize), default to document
            const effectiveContext = contextElement || document;
            const roundR3Elements = effectiveContext.querySelectorAll('.bracket-wrapper .round.r3'); // Query within context

            roundR3Elements.forEach(roundElement => {
                const parentHeight = roundElement.offsetHeight;
                if (parentHeight > 0) {
                    // We want the total margin (top + bottom) for a matchup to be 1/5 of parentHeight.
                    // So, marginTop = 1/10 of parentHeight, and marginBottom = 1/10 of parentHeight.
                    const marginValue = parentHeight * 0.06;

                    const matchupElements = roundElement.querySelectorAll('.matchup');
                    // matchupElements.forEach(matchup => {
                    //     matchup.style.marginTop = `${marginValue}px`;
                    //     matchup.style.marginBottom = `${marginValue}px`;
                    // });
                    if (matchupElements.length >= 4) { // Ensure enough matchups exist
                        matchupElements[0].style.marginTop = `${marginValue}px`;
                        matchupElements[1].style.marginBottom = `${marginValue}px`;
                        matchupElements[2].style.marginTop = `${marginValue}px`;
                        matchupElements[3].style.marginBottom = `${marginValue}px`;
                    }
                }
            });
            const roundR4Elements = effectiveContext.querySelectorAll('.bracket-wrapper .round.r4'); // Query within context

            roundR4Elements.forEach(roundElement => {
                const parentHeight2 = roundElement.offsetHeight;
                if (parentHeight2 > 0) {
                    // We want the total margin (top + botßom) for a matchup to be 1/5 of parentHeight.
                    // So, marginTop = 1/10 of parentHeight, and marginBottom = 1/10 of parentHeight.
                    const marginValue2 = parentHeight2 * 0.125;

                    const matchupElements2 = roundElement.querySelectorAll('.matchup');
                    // matchupElements.forEach(matchup => {
                    //     matchup.style.marginTop = `${marginValue}px`;
                    //     matchup.style.marginBottom = `${marginValue}px`;
                    // });

                    matchupElements2[0].style.marginTop = `${marginValue2}px`;
                    matchupElements2[2].style.marginBottom = `${marginValue2}px`;

                }
            });
        }
        const debouncedAdjustR3MatchupMargins = debounce(adjustR3MatchupMargins, 150);

        // Function to adjust font size of team names in R1 if they wrap
        function adjustTeamNameFontSize(contextElement) {
            const effectiveContext = contextElement || document;
            const teamNameSpans = effectiveContext.querySelectorAll('#bracketRow .round.r1 .team span.name');

            teamNameSpans.forEach(span => {
                span.style.fontSize = '';
                const parentTeamElement = span.parentElement;
                if (span.dataset.fullName && span.textContent !== span.dataset.fullName) {
                    span.textContent = span.dataset.fullName;
                }

                if (span.scrollHeight > parentTeamElement.clientHeight + 6) {
                    if (span.dataset.mascotName && span.textContent === span.dataset.fullName) {
                        span.textContent = span.dataset.mascotName;
                    }
                }
            });
        }
        const debouncedAdjustTeamNameFontSize = debounce(adjustTeamNameFontSize, 150);

        $(document).ready(function () {

            $(window).on('resize', function () {
                document.querySelectorAll('.modal.show').forEach(visibleModal => {
                    debouncedAdjustR3MatchupMargins(visibleModal);
                    debouncedAdjustTeamNameFontSize(visibleModal);
                });

            });


        });

    </script>
    <script nonce="<%= cspNonce %>" src="https://cdn.jsdelivr.net/npm/confetti-js@0.0.18/dist/index.min.js"
        integrity="sha384-6hNzO4CSFdKToFM9OMNvmMuRuaR0eVeAFQVjuP1P+TbmMYmU7aG2i30kNjWxprKq" crossorigin="anonymous"></script>

</body>

