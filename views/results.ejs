                        document.querySelectorAll('.details-row').forEach(row => row.remove());
                        document.querySelectorAll('tr.expanded').forEach(tr => tr.classList.remove('expanded'));
                    });
                });

                // Custom sorting function for multi-level sorting
                const customSort = (a, b) => {
                    const maxPossibleA = parseFloat(a.children[5].textContent); // Max Possible Points
                    const maxPossibleB = parseFloat(b.children[5].textContent);
                    const totalPointsA = parseFloat(a.children[3].textContent); // Total Points
                    const totalPointsB = parseFloat(b.children[3].textContent);
                    const teamsRemainingA = parseFloat(a.children[4].textContent); // Teams Remaining
                    const teamsRemainingB = parseFloat(b.children[4].textContent);

                    // Sort by Total Points (descending)
                    if (totalPointsA !== totalPointsB) {
                        return totalPointsB - totalPointsA;
                    }
                    // Then by Teams Remaining (descending)
                    if (teamsRemainingA !== teamsRemainingB) {
                        return teamsRemainingB - teamsRemainingA;
                    }
                    // Then by Max Possible Points (descending)
                    return maxPossibleB - maxPossibleA;

                };

                // Get the table body rows
                const rows = Array.from(groupTable.tBodies[0].rows);

                // Sort the rows using the custom sorting function
                rows.sort(customSort);

