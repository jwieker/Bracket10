                rows.forEach((row, index) => {
                    const currentTotalPoints = parseFloat(row.children[3].textContent); // Total Points is now at index 3

                    let assignedRank;
                    if (currentTotalPoints === previousTotalPoints) {
                        // Same total points as the previous row
                        sameRankCount++;
                        assignedRank = previousRank;
                    } else {
                        // Different total points
                        rank += sameRankCount + 1;
                        sameRankCount = 0;
