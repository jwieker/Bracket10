<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/header') %>
    <link rel="stylesheet" href="/playground.css">
</head>

<body>
  <!-- Sticky exit banner -->
  <div class="playground-banner px-3 py-2 d-flex align-items-center justify-content-between gap-2">
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-warning text-dark fw-bold">PLAYGROUND</span>
      <span class="text-muted small d-none d-sm-inline">Hypothetical results — nothing is saved</span>
    </div>
    <form action="/getFullGrid" method="POST" class="m-0 flex-shrink-0">
      <input type="hidden" name="gameName" value="<%= groupName %>">
      <input type="hidden" name="gameYear" value="<%= gameYear %>">
      <button type="submit" class="btn btn-sm btn-outline-secondary">
        &#8592; Back to <%= groupName %>
      </button>
    </form>
  </div>

  <div class="container-fluid pt-3 pb-5 px-2 px-md-4 px-xl-5">
    <div class="d-flex justify-content-end mb-3">
      <button class="btn btn-sm btn-outline-danger" id="clearAllBtn" style="display:none">
        Clear All
      </button>
    </div>

    <div class="row g-3">
      <!-- LEFT panel: game controls -->
      <div class="col-12 col-md-5 col-lg-4">
        <div class="card shadow-sm h-100">
          <div class="card-header py-2 d-flex align-items-center justify-content-between">
            <strong class="small text-uppercase text-muted">Pick Hypothetical Winners</strong>
          </div>

          <!-- Round filter tabs -->
          <div class="px-2 pt-2" id="roundTabsWrapper">
            <div class="d-flex flex-wrap gap-1" id="roundFilterBtns">
              <!-- populated by JS -->
            </div>
          </div>

          <!-- Available games list -->
          <div class="card-body p-2" id="gamesPanel">
            <!-- populated by JS -->
          </div>

          <!-- Simulated picks section -->
          <div id="simulatedSection" style="display:none">
            <div class="border-top px-3 pt-2 pb-3">
              <div class="small text-muted fw-semibold text-uppercase mb-2">Simulated Picks</div>
              <div id="simulatedList"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT panel: standings impact -->
      <div class="col-12 col-md-7 col-lg-8">
        <div class="standings-panel">
          <div class="card shadow-sm">
            <div class="card-header py-2 d-flex align-items-center justify-content-between">
              <strong class="small text-uppercase text-muted">Standings Impact</strong>
              <small class="text-muted" id="standingsSubtitle"></small>
            </div>

            <!-- Desktop table (md and up) -->
            <div class="d-none d-md-block table-responsive">
              <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3" style="width:60px">Rank</th>
                    <th>Person</th>
                    <th class="text-center" style="width:60px">Pts</th>
                    <th class="text-center" style="width:70px">Teams</th>
                    <th class="text-center" style="width:70px">Sim Pts</th>
                    <th class="text-center" style="width:80px">Sim Teams</th>
                  </tr>
                </thead>
                <tbody id="standingsTbody"></tbody>
              </table>
            </div>

            <!-- Mobile cards (below md) -->
            <div class="d-md-none p-2" id="standingsMobile"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Templates for client-side rendering (kept out of innerHTML strings) -->
  <template id="gameCardTpl">
    <div class="game-card">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <div class="d-flex align-items-center gap-2 me-2 overflow-hidden">
          <span class="badge bg-secondary flex-shrink-0 js-seed1"></span>
          <span class="fw-semibold text-truncate js-name1"></span>
        </div>
        <button class="btn btn-sm btn-outline-success flex-shrink-0 js-pick1" data-action="pick">
          Pick &nbsp;&#9654;
        </button>
      </div>
      <div class="text-center text-muted" style="font-size:.75rem;margin:-2px 0">vs</div>
      <div class="d-flex align-items-center justify-content-between mt-1">
        <div class="d-flex align-items-center gap-2 me-2 overflow-hidden">
          <span class="badge bg-secondary flex-shrink-0 js-seed2"></span>
          <span class="fw-semibold text-truncate js-name2"></span>
        </div>
        <button class="btn btn-sm btn-outline-success flex-shrink-0 js-pick2" data-action="pick">
          Pick &nbsp;&#9654;
        </button>
      </div>
    </div>
  </template>

  <template id="simItemTpl">
    <div class="d-flex align-items-center justify-content-between mb-1 gap-2">
      <span class="small text-truncate">
        <span class="text-success fw-bold">&#10003;</span>
        <strong class="js-winner"></strong>
        <span class="text-muted">beat <span class="js-loser"></span></span>
      </span>
      <button class="btn btn-link btn-sm text-danger p-0 flex-shrink-0 js-undo" data-action="undo">
        &times; Undo
      </button>
    </div>
  </template>

  <template id="standingsRowTpl">
    <tr>
      <td class="ps-3 js-rankCell"></td>
      <td>
        <div class="fw-semibold js-person"></div>
        <div class="text-muted small js-teamName"></div>
      </td>
      <td class="text-center text-muted js-totalPoints"></td>
      <td class="text-center text-muted js-teamsRemaining"></td>
      <td class="text-center fw-semibold js-simPoints"></td>
      <td class="text-center fw-semibold js-simTeams"></td>
    </tr>
  </template>

  <template id="standingsCardTpl">
    <div class="card mb-2">
      <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div class="overflow-hidden">
            <div class="fw-semibold js-personLine"></div>
            <div class="text-muted small js-teamName"></div>
          </div>
          <div class="text-end flex-shrink-0">
            <div class="text-muted small js-now"></div>
            <div class="fw-bold js-simPts"></div>
            <div class="small js-simTeamsLine"></div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Embedded data for client-side simulation -->
  <% const safeJson=obj=> JSON.stringify(obj).replace(/</g, '\\u003c' ); %>
    <script nonce="<%= cspNonce %>">
      const PLAYGROUND_DATA = {
        entries:       <%- safeJson(entries) %>,
        schoolRecords: <%- safeJson(schoolRecords) %>,
        pendingGames:  <%- safeJson(pendingGames) %>,
        allGames:      <%- safeJson(allGames) %>,
        roundPoints:   <%- safeJson(roundPoints) %>,
        roundNames:    <%- safeJson(roundNames) %>,
      };
    </script>

    <%- include('partials/scripts') %>

      <script nonce="<%= cspNonce %>">
        // ─────────────────────────────────────────────────
        // State
        // ─────────────────────────────────────────────────
        let simulatedWinners = []; // [{gameID, winnerSID, loserSID, round, winnerName, loserName}]
        let currentFilter = 'all';
        let lastDisplayGames = [];
        let lastAppliedIDs = new Set();

        // ─────────────────────────────────────────────────
        // Core simulation logic
        // ─────────────────────────────────────────────────

        function deepCloneRecords(records) {
          return records.map(r => ({ ...r, gameStatus: r.gameStatus ? [...r.gameStatus] : [] }));
        }

        function deepCloneGames(games) {
          return games.map(g => ({ ...g }));
        }

        /**
         * Applies a simulated winner to in-memory clones of the game and school record data.
         * Returns true if the pick was valid and applied, false if the winner was not in this game
         * (e.g. a cascade was broken by undoing an earlier pick).
         */
        function applySimulatedWinner(clonedGames, recordMap, gameID, winnerSID) {
          const game = clonedGames.find(g => g.gameID === gameID);
          if (!game) return false;

          // Guard: the winner must actually be one of the teams in this game
          if (game.team1ID !== winnerSID && game.team2ID !== winnerSID) return false;

          const loserSID = game.team1ID === winnerSID ? game.team2ID : game.team1ID;

          const winner = recordMap.get(winnerSID);
          if (winner) winner.gameStatus.push('W');

          const loser = recordMap.get(loserSID);
          if (loser) loser.gameStatus.push('L');

          game.winner = winnerSID;

          // Advance winner into the next game slot
          if (game.nextGameID) {
            const nextGame = clonedGames.find(g => g.gameID === game.nextGameID);
            if (nextGame) {
              if (game.nextGameSpot === 1) nextGame.team1ID = winnerSID;
              else nextGame.team2ID = winnerSID;
            }
          }

          return true;
        }

        function calcEntrySimPoints(entry, recordMap) {
          let total = 0;
          for (const sID of entry.picks) {
            const sr = recordMap.get(sID);
            if (!sr || !sr.gameStatus) continue;
            for (let i = 0; i < sr.gameStatus.length; i++) {
              if (sr.gameStatus[i] === 'W') {
                total += PLAYGROUND_DATA.roundPoints[i];
              }
            }
          }
          return total;
        }

        function calcSimTeamsRemaining(entry, recordMap) {
          let remaining = entry.picks.length;
          for (const sID of entry.picks) {
            const sr = recordMap.get(sID);
            if (sr && sr.gameStatus && sr.gameStatus.includes('L')) remaining--;
          }
          return remaining;
        }

        function runSimulation() {
          const clonedRecords = deepCloneRecords(PLAYGROUND_DATA.schoolRecords);
          const clonedGames = deepCloneGames(PLAYGROUND_DATA.allGames);
          const recordMap = new Map(clonedRecords.map(r => [r.sID, r]));

          // Apply picks in round order so game chain advancement is correct
          const sortedWinners = [...simulatedWinners].sort((a, b) => a.round - b.round);
          const appliedGameIDs = new Set();
          for (const sw of sortedWinners) {
            const applied = applySimulatedWinner(clonedGames, recordMap, sw.gameID, sw.winnerSID);
            if (applied) appliedGameIDs.add(sw.gameID);
          }

          // Compute simulated standings
          const simEntries = PLAYGROUND_DATA.entries.map(e => ({
            ...e,
            simPoints: calcEntrySimPoints(e, recordMap),
            simTeamsRemaining: calcSimTeamsRemaining(e, recordMap),
          }));

          simEntries.sort((a, b) => {
            if (a.simPoints !== b.simPoints) return b.simPoints - a.simPoints;
            return b.simTeamsRemaining - a.simTeamsRemaining;
          });

          // Assign ranks (with ties)
          let simRank = 0, prevPoints = -1, prevRank = 0, sameCount = 0;
          simEntries.forEach(e => {
            if (e.simPoints === prevPoints) {
              sameCount++;
              e.simRank = prevRank;
            } else {
              simRank += sameCount + 1;
              sameCount = 0;
              e.simRank = simRank;
              prevRank = simRank;
            }
            prevPoints = e.simPoints;
          });

          // Games available to pick: both teams set, no winner, not yet simulated
          const displayGames = clonedGames
            .filter(g => g.team1ID && g.team2ID && !g.winner && !appliedGameIDs.has(g.gameID))
            .sort((a, b) => a.round - b.round || a.gameID - b.gameID)
            .map(g => {
              // Try original pendingGames first (has pre-computed names), else look up from cloned records
              const original = PLAYGROUND_DATA.pendingGames.find(p => p.gameID === g.gameID);
              if (original) return original;
              const t1 = recordMap.get(g.team1ID) || {};
              const t2 = recordMap.get(g.team2ID) || {};
              const roundMeta = PLAYGROUND_DATA.roundNames.find(r => r.round === g.round) || {};
              return {
                gameID: g.gameID,
                round: g.round,
                roundName: roundMeta.name || `Round ${g.round}`,
                nextGameID: g.nextGameID,
                nextGameSpot: g.nextGameSpot,
                team1ID: g.team1ID,
                team1Name: t1.nameNick || t1.name || `Team ${g.team1ID}`,
                team1Seed: t1.seed ?? null,
                team2ID: g.team2ID,
                team2Name: t2.nameNick || t2.name || `Team ${g.team2ID}`,
                team2Seed: t2.seed ?? null,
              };
            });

          return { simEntries, displayGames, appliedGameIDs };
        }

        // ─────────────────────────────────────────────────
        // User actions
        // ─────────────────────────────────────────────────

        function pickWinner(gameID, winnerSID, winnerName, loserSID, loserName, round) {
          simulatedWinners = simulatedWinners.filter(sw => sw.gameID !== gameID);
          simulatedWinners.push({ gameID, winnerSID, loserSID, round, winnerName, loserName });
          updateUI();
        }

        function undoPick(gameID) {
          simulatedWinners = simulatedWinners.filter(sw => sw.gameID !== gameID);
          updateUI();
        }

        function clearAll() {
          simulatedWinners = [];
          updateUI();
        }

        function filterRound(round, btn) {
          currentFilter = round;
          document.querySelectorAll('#roundFilterBtns button').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          renderGames(lastDisplayGames);
        }

        // ─────────────────────────────────────────────────
        // Rendering
        // ─────────────────────────────────────────────────

        function updateUI() {
          const { simEntries, displayGames, appliedGameIDs } = runSimulation();
          lastDisplayGames = displayGames;
          lastAppliedIDs = appliedGameIDs;
          renderRoundTabs(displayGames);
          renderGames(displayGames);
          renderSimulatedList(appliedGameIDs);
          renderStandings(simEntries);
          renderSimCount();
          document.getElementById('clearAllBtn').style.display = simulatedWinners.length ? '' : 'none';
        }

        function renderRoundTabs(displayGames) {
          const rounds = [...new Set(displayGames.map(g => g.round))].sort((a, b) => a - b);
          const container = document.getElementById('roundFilterBtns');
          const isAllActive = currentFilter === 'all';
          const allBtn = document.createElement('button');
          allBtn.className = `btn btn-sm btn-warning${isAllActive ? ' active' : ''}`;
          allBtn.dataset.action = 'filter';
          allBtn.dataset.round = 'all';
          allBtn.textContent = 'All';
          const nodes = [allBtn];
          rounds.forEach(r => {
            const meta = PLAYGROUND_DATA.roundNames.find(rn => rn.round === r);
            const rName = meta ? meta.name : `Round ${r}`;
            const isActive = currentFilter == r;
            const btn = document.createElement('button');
            btn.className = `btn btn-sm btn-outline-secondary${isActive ? ' active' : ''}`;
            btn.dataset.round = r;
            btn.dataset.action = 'filter';
            btn.textContent = rName;
            nodes.push(btn);
          });
          container.replaceChildren(...nodes);
        }

        function renderGames(displayGames) {
          const panel = document.getElementById('gamesPanel');

          const filtered = currentFilter === 'all'
            ? displayGames
            : displayGames.filter(g => String(g.round) === String(currentFilter));

          if (filtered.length === 0) {
            const allDone = simulatedWinners.length > 0 && displayGames.length === 0;
            const p = document.createElement('p');
            p.className = 'text-muted small text-center py-2';
            p.textContent = allDone ? 'All available games have been simulated.' : 'No games match this filter.';
            panel.replaceChildren(p);
            return;
          }

          // Group by round
          const byRound = {};
          filtered.forEach(g => {
            if (!byRound[g.round]) byRound[g.round] = [];
            byRound[g.round].push(g);
          });

          const tpl = document.getElementById('gameCardTpl');
          const nodes = [];
          Object.keys(byRound).sort((a, b) => a - b).forEach(round => {
            const games = byRound[round];
            if (currentFilter === 'all') {
              const header = document.createElement('div');
              header.className = 'small text-muted fw-semibold mb-1 mt-2 text-uppercase';
              header.style.letterSpacing = '.04em';
              header.textContent = games[0].roundName ?? '';
              nodes.push(header);
            }
            games.forEach(g => {
              const card = tpl.content.firstElementChild.cloneNode(true);
              card.querySelector('.js-seed1').textContent = g.team1Seed != null ? g.team1Seed : '?';
              card.querySelector('.js-name1').textContent = g.team1Name ?? '';
              card.querySelector('.js-seed2').textContent = g.team2Seed != null ? g.team2Seed : '?';
              card.querySelector('.js-name2').textContent = g.team2Name ?? '';

              const pick1 = card.querySelector('.js-pick1');
              pick1.dataset.gameId = g.gameID;
              pick1.dataset.winnerSid = g.team1ID;
              pick1.dataset.winnerName = g.team1Name ?? '';
              pick1.dataset.loserSid = g.team2ID;
              pick1.dataset.loserName = g.team2Name ?? '';
              pick1.dataset.round = g.round;

              const pick2 = card.querySelector('.js-pick2');
              pick2.dataset.gameId = g.gameID;
              pick2.dataset.winnerSid = g.team2ID;
              pick2.dataset.winnerName = g.team2Name ?? '';
              pick2.dataset.loserSid = g.team1ID;
              pick2.dataset.loserName = g.team1Name ?? '';
              pick2.dataset.round = g.round;

              nodes.push(card);
            });
          });

          panel.replaceChildren(...nodes);
        }

        function renderSimulatedList(appliedGameIDs) {
          const section = document.getElementById('simulatedSection');
          const list = document.getElementById('simulatedList');

          const applied = simulatedWinners.filter(sw => appliedGameIDs.has(sw.gameID));

          if (applied.length === 0) {
            section.style.display = 'none';
            return;
          }

          section.style.display = '';
          const sorted = [...applied].sort((a, b) => a.round - b.round);
          const tpl = document.getElementById('simItemTpl');
          const nodes = sorted.map(sw => {
            const item = tpl.content.firstElementChild.cloneNode(true);
            item.querySelector('.js-winner').textContent = sw.winnerName ?? '';
            item.querySelector('.js-loser').textContent = sw.loserName ?? '';
            item.querySelector('.js-undo').dataset.gameId = sw.gameID;
            return item;
          });
          list.replaceChildren(...nodes);
        }

        function rankArrowEl(rankChange) {
          if (rankChange === 0) return null;
          const span = document.createElement('span');
          span.className = rankChange > 0 ? 'rank-up me-1' : 'rank-down me-1';
          span.textContent = rankChange > 0 ? '↑' : '↓';
          return span;
        }

        function renderStandings(simEntries) {
          const tbody = document.getElementById('standingsTbody');
          const mobileDiv = document.getElementById('standingsMobile');
          const rowTpl = document.getElementById('standingsRowTpl');
          const cardTpl = document.getElementById('standingsCardTpl');
          const rows = [];
          const cards = [];

          simEntries.forEach(e => {
            const rankChange = e.rank - e.simRank; // positive = moved up (rank number decreased)
            const rowClass = rankChange > 0 ? 'row-up' : rankChange < 0 ? 'row-down' : '';
            const cardClass = rankChange > 0 ? 'card-up' : rankChange < 0 ? 'card-down' : '';
            const simPtsClass = e.simPoints > e.totalPoints ? 'delta-pos' : e.simPoints < e.totalPoints ? 'delta-neg' : '';
            const simTeamsClass = e.simTeamsRemaining < e.teamsRemaining ? 'delta-neg' : '';

            // Desktop table row
            const row = rowTpl.content.firstElementChild.cloneNode(true);
            if (rowClass) row.classList.add(rowClass);
            const rankCell = row.querySelector('.js-rankCell');
            const rowArrow = rankArrowEl(rankChange);
            if (rowArrow) rankCell.appendChild(rowArrow);
            rankCell.appendChild(document.createTextNode(String(e.simRank)));
            row.querySelector('.js-person').textContent = e.person ?? '';
            row.querySelector('.js-teamName').textContent = e.teamName ?? '';
            row.querySelector('.js-totalPoints').textContent = e.totalPoints;
            row.querySelector('.js-teamsRemaining').textContent = e.teamsRemaining;
            const simPtsCell = row.querySelector('.js-simPoints');
            simPtsCell.textContent = e.simPoints;
            if (simPtsClass) simPtsCell.classList.add(simPtsClass);
            const simTeamsCell = row.querySelector('.js-simTeams');
            simTeamsCell.textContent = e.simTeamsRemaining;
            if (simTeamsClass) simTeamsCell.classList.add(simTeamsClass);
            rows.push(row);

            // Mobile card
            const card = cardTpl.content.firstElementChild.cloneNode(true);
            if (cardClass) card.classList.add(cardClass);
            const personLine = card.querySelector('.js-personLine');
            const cardArrow = rankArrowEl(rankChange);
            if (cardArrow) personLine.appendChild(cardArrow);
            personLine.appendChild(document.createTextNode(`#${e.simRank} ${e.person ?? ''}`));
            card.querySelector('.js-teamName').textContent = e.teamName ?? '';
            card.querySelector('.js-now').textContent = `Now: ${e.totalPoints} pts · ${e.teamsRemaining} teams`;
            const simPtsLine = card.querySelector('.js-simPts');
            simPtsLine.textContent = `${e.simPoints} pts`;
            if (simPtsClass) simPtsLine.classList.add(simPtsClass);
            const simTeamsLine = card.querySelector('.js-simTeamsLine');
            simTeamsLine.textContent = `${e.simTeamsRemaining} teams left`;
            if (simTeamsClass) simTeamsLine.classList.add(simTeamsClass);
            cards.push(card);
          });

          tbody.replaceChildren(...rows);
          mobileDiv.replaceChildren(...cards);
        }

        function renderSimCount() {
          const subtitle = document.getElementById('standingsSubtitle');
          const n = lastAppliedIDs.size;
          if (n === 0) {
            subtitle.textContent = '';
          } else {
            subtitle.textContent = `${n} game${n !== 1 ? 's' : ''} simulated`;
          }
        }

        // ─────────────────────────────────────────────────
        // Utilities
        // ─────────────────────────────────────────────────

        function escJs(str) {
          if (str == null) return '';
          return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
        }

        // ─────────────────────────────────────────────────
        // Event delegation (CSP blocks inline onclick attrs)
        // ─────────────────────────────────────────────────

        // Round filter buttons
        document.getElementById('roundFilterBtns').addEventListener('click', function(e) {
          const btn = e.target.closest('button[data-action="filter"]');
          if (!btn) return;
          const round = btn.dataset.round;
          filterRound(round === 'all' ? 'all' : Number(round), btn);
        });

        // Pick buttons (delegated to gamesPanel which is re-rendered each time)
        document.getElementById('gamesPanel').addEventListener('click', function(e) {
          const btn = e.target.closest('button[data-action="pick"]');
          if (!btn) return;
          const d = btn.dataset;
          pickWinner(Number(d.gameId), Number(d.winnerSid), d.winnerName, Number(d.loserSid), d.loserName, Number(d.round));
        });

        // Undo buttons (delegated to simulatedList)
        document.getElementById('simulatedList').addEventListener('click', function(e) {
          const btn = e.target.closest('button[data-action="undo"]');
          if (!btn) return;
          undoPick(Number(btn.dataset.gameId));
        });

        // Clear All button
        document.getElementById('clearAllBtn').addEventListener('click', clearAll);

        updateUI();
      </script>
</body>

</html>